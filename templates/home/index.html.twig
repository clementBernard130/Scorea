{% extends 'base.html.twig' %}

{% block title %}Accueil - Scorea{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-100">
    <div class="max-w-7xl mx-auto px-4 py-6">
        <header class="bg-white shadow-md rounded-lg px-6 py-4 mb-8 flex flex-wrap items-center justify-between gap-4">
            <h1 class="text-2xl font-bold text-gray-800">Scorea</h1>
            <div class="flex items-center gap-4 flex-wrap">
                {% if user %}
                    <span class="text-gray-600">
                        Bienvenue, <strong class="text-gray-800">{{ user.firstName }} {{ user.lastName }}</strong>
                    </span>
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('admin') }}" class="px-4 py-2 bg-gray-600 text-white rounded-lg hover:bg-gray-700 transition font-medium">
                            Administration
                        </a>
                    {% endif %}
                    <a href="{{ path('app_logout') }}" class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition font-medium">
                        Déconnexion
                    </a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition font-medium">
                        Connexion
                    </a>
                {% endif %}
            </div>
        </header>

        <main>
            {% if user %}
                <div class="bg-white rounded-lg shadow-md p-8">
                    <h2 class="text-2xl font-semibold text-gray-800 mb-6">Tableau de bord</h2>
                    
                    <div class="mb-6">
                        <p class="text-gray-600 mb-3">
                            Vous êtes connecté avec les rôles suivants :
                        </p>
                        <ul class="list-disc list-inside text-gray-600 space-y-1">
                            {% for role in user.roles %}
                                <li class="ml-4">{{ role }}</li>
                            {% endfor %}
                        </ul>
                    </div>

                    {% if is_granted('ROLE_TEACHER') %}
                        <div class="bg-cyan-50 border-l-4 border-cyan-700 p-4 mb-6 rounded">
                            <strong class="text-cyan-900 block mb-2">Espace Enseignant</strong>
                            <p class="text-cyan-800">Vous avez accès aux fonctionnalités enseignant.</p>
                        </div>
                    {% endif %}

                    {% if is_granted('ROLE_STUDENT') %}
                        <div class="bg-green-50 border-l-4 border-green-700 p-4 mb-6 rounded">
                            <strong class="text-green-900 block mb-2">Espace Étudiant</strong>
                            <p class="text-green-800">Vous avez accès aux fonctionnalités étudiant.</p>
                        </div>
                    {% endif %}

                    {% if is_granted('ROLE_ADMIN') %}
                        <div class="bg-yellow-50 border-l-4 border-yellow-700 p-4 mb-6 rounded">
                            <strong class="text-yellow-900 block mb-2">Espace Administrateur</strong>
                            <p class="text-yellow-800">Vous avez accès à toutes les fonctionnalités d'administration.</p>
                        </div>
                    {% endif %}
                </div>
            {% else %}
                <div class="text-center py-16">
                    <h2 class="text-3xl font-bold text-gray-800 mb-4">Bienvenue sur Scorea</h2>
                    <p class="text-gray-600 mb-8 text-lg">Veuillez vous connecter pour accéder à l'application.</p>
                    <a href="{{ path('app_login') }}" class="inline-block px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition font-medium text-lg">
                        Se connecter
                    </a>
                </div>
            {% endif %}
        </main>
    </div>
</div>
{% endblock %}
