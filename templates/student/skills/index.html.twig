{% extends 'base.html.twig' %}

{% block title %}Mon Espace{% endblock %}

{% block body %}
<div class="min-h-screen overflow-hidden bg-gradient-to-b from-sky-50 via-white to-slate-100 px-4 py-10 relative">
    <div class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-72 bg-[radial-gradient(circle_at_top_left,rgba(14,165,233,0.18),transparent_38%),radial-gradient(circle_at_top_right,rgba(59,130,246,0.16),transparent_30%)]"></div>

    <div class="mx-auto max-w-6xl relative z-10" data-controller="dialog">
        <header class="mb-6 flex flex-col gap-4 rounded-[28px] border border-white/70 bg-white/85 p-6 shadow-[0_18px_45px_rgba(15,23,42,0.08)] backdrop-blur md:flex-row md:items-center md:justify-between md:p-8">
            <div>
                <h1 class="text-4xl font-black tracking-tight text-slate-900 md:text-5xl">Mon espace</h1>
            </div>
            <div class="flex flex-wrap items-center gap-3">
                <a href="{{ path('student_profile') }}" class="inline-flex items-center justify-center rounded-full border border-slate-300 bg-white px-5 py-3 text-sm font-bold text-slate-700 transition hover:bg-slate-50">
                    Mon profil
                </a>
                <a href="{{ path('app_logout') }}" class="inline-flex items-center justify-center rounded-full bg-gradient-to-r from-red-600 to-rose-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-red-200 transition hover:-translate-y-0.5 hover:shadow-red-300">
                    Déconnexion
                </a>
            </div>
        </header>

        <section class="mb-8 grid gap-4 grid-cols-1">
            <div>
                <div class="rounded-[24px] border border-white/70 bg-white/90 p-5 shadow-[0_18px_45px_rgba(15,23,42,0.08)] backdrop-blur">
                    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                        <div>
                            <p class="text-xs font-bold uppercase tracking-[0.22em] text-slate-500">Dernière matière évaluée</p>
                            <p class="mt-2 text-base font-semibold text-slate-900">
                               {{ page.latestEvaluatedSubject ? page.latestEvaluatedSubject.name : 'Aucune évaluation' }}
                            </p>
                            {% if page.latestEvaluatedSubject %}
                                <p class="mt-1 text-sm text-slate-500">
                                    Évaluée le {{ page.latestEvaluatedSubject.date }}
                                </p>
                            {% endif %}
                        </div>
                        <a href="{{ path('student_evaluation_history') }}" class="inline-flex shrink-0 items-center justify-center rounded-full border border-slate-300 bg-white px-5 py-3 text-sm font-bold text-slate-700 transition hover:bg-slate-50">
                            Historique des évaluations
                        </a>
                    </div>
                </div>

            </div>
        </section>

        {% if page.units is empty %}
            <section class="rounded-[28px] border border-dashed border-sky-200 bg-white/90 px-6 py-14 text-center shadow-[0_18px_45px_rgba(15,23,42,0.08)] backdrop-blur">
                <h2 class="text-2xl font-bold text-slate-900">Aucune unité de compétence trouvée</h2>
                <p class="mx-auto mt-3 max-w-2xl text-slate-600">
                    Aucun bloc de compétences n'est actuellement rattaché à votre formation.
                </p>
            </section>
        {% else %}
            <div class="overflow-x-auto rounded-[24px] border border-white/70 bg-white/90 shadow-[0_18px_45px_rgba(15,23,42,0.08)] backdrop-blur">
                <table class="w-full min-w-[800px] border-collapse text-left text-sm">
                    <thead>
                        <tr class="bg-slate-50/50 text-xs font-bold uppercase text-slate-700">
                            <th class="border-b border-slate-200 px-4 py-4 w-1/2">Élément</th>
                            <th class="border-b border-slate-200 px-4 py-4 text-center border-l">Notes</th>
                            <th class="border-b border-slate-200 px-4 py-4 text-center border-l w-32">Moyenne</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for unit in page.units %}
                            {% set unitAverage = page.unitAverages[unit.id] ?? null %}
                            {% set isUnitFailing = unitAverage is not null and unitAverage < 10 %}
                            <tr class="bg-amber-50/60">
                                <td class="border-b border-slate-200 px-4 py-3 font-bold text-slate-900" colspan="2">
                                    {{ unit.name }}
                                </td>
                                <td class="border-b border-slate-200 px-4 py-3 text-center font-bold border-l {{ isUnitFailing ? 'text-red-700' : 'text-slate-900' }}">
                                    {{ unitAverage is not null ? unitAverage|number_format(2, ',', '') ~ '/20' : '' }}
                                </td>
                            </tr>

                            {% for skill in unit.skills %}
                                {% set skillGrade = page.skillGrades[skill.id] ?? null %}
                                {% set isSkillFailing = skillGrade and skillGrade.average is not null and skillGrade.average < 10 %}
                                
                                <tr class="{{ isSkillFailing ? 'bg-red-50/80' : 'bg-slate-50/40' }}">
                                    <td class="border-b border-slate-200 px-4 py-3 pl-8 font-semibold {{ isSkillFailing ? 'text-red-800' : 'text-slate-800' }}">
                                        {{ skill.name }}
                                    </td>
                                    <td class="border-b border-slate-200 px-4 py-3 text-center text-slate-500 border-l"></td>
                                    <td class="border-b border-slate-200 px-4 py-3 text-center font-bold border-l {{ isSkillFailing ? 'text-red-700' : 'text-slate-900' }}">
                                        {{ skillGrade and skillGrade.average is not null ? skillGrade.average|number_format(2, ',', '') : '' }}
                                    </td>
                                </tr>

                                {% if skillGrade and skillGrade.subjects is not empty %}
                                    {% for subjectGrade in skillGrade.subjects %}
                                        {% set isSubjectFailing = subjectGrade.average is not null and subjectGrade.average < 10 %}
                                        
                                        <tr class="{{ isSubjectFailing ? 'bg-red-50/40 hover:bg-red-100/50' : 'bg-white hover:bg-slate-50/80' }} transition-colors">
                                            <td class="border-b border-slate-200 px-4 py-3 pl-12 {{ isSubjectFailing ? 'text-red-800' : 'text-slate-700' }}">
                                                {{ subjectGrade.name }}
                                            </td>
                                            <td class="border-b border-slate-200 px-4 py-3 border-l">
                                                <div class="mx-auto flex max-w-xs flex-col gap-2">
                                                    {% for grade in subjectGrade.grades %}
                                                        {% set isGradeFailing = grade.value < 10 %}
                                                        
                                                        <a href="{{ path('grade_details', {id: grade.id}) }}" data-turbo-frame="modal_content" data-action="click->dialog#open" class="flex items-center justify-between rounded-lg border px-3 py-2 text-sm transition-all cursor-pointer group {{ isGradeFailing ? 'border-red-300 bg-red-50 text-red-900 hover:bg-red-100' : 'border-slate-200 bg-slate-50 text-slate-800 hover:bg-sky-100 hover:border-sky-300' }}">
                                                            <span class="font-medium {{ isGradeFailing ? 'text-red-500 group-hover:text-red-700' : 'text-slate-500 group-hover:text-sky-600' }}">Note {{ loop.index }}</span>
                                                            <span class="font-bold {{ isGradeFailing ? 'text-red-700 group-hover:text-red-800' : 'text-slate-900 group-hover:text-sky-700' }}">{{ grade.value|number_format(2, ',', '') }}/20</span>
                                                        </a>
                                                    {% endfor %}
                                                </div>
                                            </td>
                                            <td class="border-b border-slate-200 px-4 py-3 text-center font-semibold border-l {{ isSubjectFailing ? 'text-red-700' : 'text-slate-800' }}">
                                                {{ subjectGrade.average|number_format(2, ',', '') }}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                {% endif %}
                            {% endfor %}
                        {% endfor %}
                        
                        <tr class="bg-teal-600 text-white">
                            <td class="px-4 py-4 font-bold" colspan="2">Moyenne générale</td>
                            <td class="px-4 py-4 text-center font-bold text-white border-l border-teal-500">
                                {{ page.globalAverage is not null ? page.globalAverage|number_format(2, ',', '') ~ '/20' : 'N/A' }}
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        {% endif %}

        <dialog data-dialog-target="modal" data-action="click->dialog#clickOutside" class="fixed inset-0 m-auto w-full max-w-md rounded-[24px] border border-slate-200 bg-white/95 p-6 shadow-[0_18px_45px_rgba(15,23,42,0.15)] backdrop-blur backdrop:bg-slate-900/40 backdrop:backdrop-blur-sm">
            <div class="mb-2 flex justify-end">
                <button data-action="click->dialog#close" class="text-slate-400 transition-colors hover:text-slate-600">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
            </div>
            <turbo-frame id="modal_content">
                <div class="flex justify-center p-4">
                    <span class="text-slate-500">Chargement...</span>
                </div>
            </turbo-frame>
        </dialog>
    </div>
</div>
{% endblock %}