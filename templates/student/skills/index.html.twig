{% extends 'base.html.twig' %}

{% block title %}Mes compétences{% endblock %}

{% block body %}
<div class="min-h-screen overflow-hidden bg-gradient-to-b from-sky-50 via-white to-slate-100 px-4 py-10">
    <div class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-72 bg-[radial-gradient(circle_at_top_left,rgba(14,165,233,0.18),transparent_38%),radial-gradient(circle_at_top_right,rgba(59,130,246,0.16),transparent_30%)]"></div>

    <div class="mx-auto max-w-6xl">
        <header class="mb-6 flex flex-col gap-4 rounded-[28px] border border-white/70 bg-white/85 p-6 shadow-[0_18px_45px_rgba(15,23,42,0.08)] backdrop-blur md:flex-row md:items-center md:justify-between md:p-8">
            <div>
                <p class="mb-2 text-xs font-bold uppercase tracking-[0.28em] text-sky-700">Espace étudiant</p>
                <h1 class="text-4xl font-black tracking-tight text-slate-900 md:text-5xl">Mes compétences</h1>
                <p class="mt-3 text-base text-slate-600">{{ user.firstName }} {{ user.lastName }}</p>
            </div>
            <a href="{{ path('app_logout') }}" class="inline-flex items-center justify-center rounded-full bg-gradient-to-r from-red-600 to-rose-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-red-200 transition hover:-translate-y-0.5 hover:shadow-red-300">
                Déconnexion
            </a>
        </header>

        <section class="mb-6 grid gap-4 md:grid-cols-2">
            {% for label, values in {
                'Sections': page.sectionNames,
                'Formations': page.trainingNames
            } %}
            <div>
                <div class="rounded-[24px] border border-white/70 bg-white/90 p-5 shadow-[0_18px_45px_rgba(15,23,42,0.08)] backdrop-blur">
                    <p class="text-xs font-bold uppercase tracking-[0.22em] text-slate-500">{{ label }}</p>
                    <p class="mt-2 text-base font-semibold text-slate-900">
                        {{ values is not empty ? values|join(', ') : 'Aucune donnée' }}
                    </p>
                </div>
            </div>
            {% endfor %}
        </section>

        {% if page.units is empty %}
            <section class="rounded-[28px] border border-dashed border-sky-200 bg-white/90 px-6 py-14 text-center shadow-[0_18px_45px_rgba(15,23,42,0.08)] backdrop-blur">
                <h2 class="text-2xl font-bold text-slate-900">Aucune unité de compétence trouvée</h2>
                <p class="mx-auto mt-3 max-w-2xl text-slate-600">
                    Aucun bloc de compétences n'est actuellement rattaché à votre formation.
                </p>
            </section>
        {% else %}
            <div class="space-y-5">
                {% for unit in page.units %}
                    <section class="overflow-hidden rounded-[28px] border border-white/70 bg-white/90 shadow-[0_18px_45px_rgba(15,23,42,0.08)] backdrop-blur">
                        <div class="border-b border-slate-200/80 bg-gradient-to-r from-slate-50 to-white px-6 py-5 md:px-7">
                            <h2 class="text-xl font-bold text-slate-900 md:text-2xl">{{ unit.name }}</h2>
                            <p class="mt-2 max-w-3xl text-sm leading-6 text-slate-600">{{ unit.description }}</p>
                        </div>

                        <ul class="divide-y divide-slate-200/80">
                            {% for skill in unit.skills %}
                                {% set skillGrade = page.skillGrades[skill.id] ?? null %}
                                <li class="flex flex-col gap-4 px-6 py-5 md:flex-row md:items-center md:justify-between md:px-7">
                                    <div class="min-w-0 flex-1">
                                        <p class="text-base font-bold text-slate-900">{{ skill.name }}</p>
                                        <p class="mt-1 text-sm leading-6 text-slate-600">{{ skill.description }}</p>
                                        {% if skillGrade and skillGrade.subjects is not empty %}
                                            <div class="mt-3 flex flex-wrap gap-2">
                                                {% for subjectGrade in skillGrade.subjects %}
                                                    <span class="inline-flex items-center rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700">
                                                        {{ subjectGrade.name }} : {{ subjectGrade.average|number_format(1, ',', '') }}/20
                                                    </span>
                                                {% endfor %}
                                            </div>
                                        {% endif %}
                                    </div>
                                    <span class="inline-flex min-w-28 items-center justify-center rounded-full px-4 py-2 text-sm font-bold {% if skillGrade and skillGrade.average is not null %}bg-blue-100 text-blue-800{% else %}bg-slate-100 text-slate-700{% endif %}">
                                        {{ skillGrade and skillGrade.average is not null ? 'Moy. ' ~ skillGrade.average|number_format(1, ',', '') ~ '/20' : 'Non noté' }}
                                    </span>
                                </li>
                            {% endfor %}
                        </ul>
                    </section>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
