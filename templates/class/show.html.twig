{% extends 'base.html.twig' %}

{% block title %}{{ section.name }} - Scorea{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-100 text-gray-900">
    <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
        <header class="mb-8 flex flex-wrap items-center justify-between gap-4 rounded-md bg-white px-6 py-4 shadow-md">
            <div>
                <p class="text-xs uppercase tracking-wide text-gray-500">Classe</p>
                <h1 class="text-2xl font-semibold text-gray-900">{{ section.name }}</h1>
            </div>
            <div class="flex flex-wrap items-center gap-3">
                <a href="{{ path('app_home') }}" class="rounded-md border border-gray-300 bg-white px-4 py-2 font-medium text-gray-700 transition hover:bg-gray-50">
                    Retour au tableau de bord
                </a>
                <a href="{{ path('teacher_portal_test_new', { section: section.id }) }}" class="rounded-md bg-blue-600 px-4 py-2 font-medium text-white transition hover:bg-blue-700">
                    Nouveau test
                </a>
            </div>
        </header>

        <section class="mb-8 grid gap-4 lg:grid-cols-[1.3fr_0.7fr]">
            <div class="rounded-md bg-white p-6 shadow-md sm:p-8">
                <p class="text-sm uppercase tracking-wide text-gray-500">Vue d'ensemble</p>
                <h2 class="mt-2 text-3xl font-semibold text-gray-900">{{ section.training.name }}</h2>
                <p class="mt-2 max-w-3xl text-gray-600">
                    {{ section.startDate|date('d/m/Y') }} - {{ section.endDate|date('d/m/Y') }}
                </p>
                <div class="mt-6 flex flex-wrap gap-3 text-sm">
                    <div class="rounded-md border border-gray-200 bg-gray-50 px-4 py-2 text-gray-700">
                        {{ students|length }} étudiant{% if students|length > 1 %}s{% endif %}
                    </div>
                    <div class="rounded-md border border-gray-200 bg-gray-50 px-4 py-2 text-gray-700">
                        {{ tests|length }} test{% if tests|length > 1 %}s{% endif %}
                    </div>
                </div>
            </div>

            <div class="rounded-md bg-white p-6 text-gray-900 shadow-md sm:p-8">
                <p class="text-sm uppercase tracking-wide text-gray-500">Actions rapides</p>
                <div class="mt-4 space-y-3">
                    <a href="{{ path('teacher_portal_test_new', { section: section.id }) }}" class="flex items-center justify-between rounded-md bg-blue-600 px-4 py-3 text-white transition hover:bg-blue-700">
                        <span>Créer une évaluation</span>
                        <span>→</span>
                    </a>
                </div>
            </div>
        </section>

        <section class="mb-8 rounded-md bg-white p-6 text-gray-900 shadow-md sm:p-8">
            <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
                <div>
                    <p class="text-sm uppercase tracking-wide text-gray-500">Étudiants</p>
                    <h2 class="text-2xl font-semibold text-gray-900">Liste de classe</h2>
                </div>
            </div>

            {% if students is not empty %}
                <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-3">
                    {% for student in students %}
                        <article class="rounded-md border border-gray-200 bg-white p-4 shadow-sm">
                            <p class="text-xs uppercase tracking-wide text-gray-500">Étudiant</p>
                            <h3 class="mt-2 text-lg font-semibold text-gray-900">{{ student.firstName }} {{ student.lastName }}</h3>
                            <p class="mt-1 text-sm text-gray-600">{{ student.username }}</p>
                        </article>
                    {% endfor %}
                </div>
            {% else %}
                <div class="rounded-md border border-dashed border-gray-300 bg-gray-50 p-6 text-gray-600">
                    Aucun étudiant n'est associé à cette classe.
                </div>
            {% endif %}
        </section>

        <section class="rounded-md bg-white p-6 text-gray-900 shadow-md sm:p-8">
            <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
                <div>
                    <p class="text-sm uppercase tracking-wide text-gray-500">Tests et assignments</p>
                    <h2 class="text-2xl font-semibold text-gray-900">Mes évaluations</h2>
                </div>
                <a href="{{ path('teacher_portal_test_new', { section: section.id }) }}" class="rounded-md bg-blue-600 px-4 py-2 font-medium text-white transition hover:bg-blue-700">
                    Nouveau test
                </a>
            </div>

            {% if tests is not empty %}
                <div class="space-y-3">
                    {% for test in tests %}
                        <article class="flex flex-col gap-4 rounded-md border border-gray-200 bg-white p-4 shadow-sm sm:flex-row sm:items-center sm:justify-between">
                            <div>
                                <p class="text-xs uppercase tracking-wide text-gray-500">{{ test.testDate|date('d/m/Y') }}</p>
                                <h3 class="mt-1 text-lg font-semibold text-gray-900">{{ test.subject.name }}</h3>
                                <p class="mt-1 text-sm text-gray-600">{{ test.comment ?: 'Aucun commentaire' }}</p>
                            </div>
                            <div class="flex flex-wrap items-center gap-3">
                                <div class="rounded-md border border-gray-200 bg-gray-50 px-4 py-2 text-sm font-medium text-gray-700">
                                    {{ test.teacher }}
                                </div>
                                <a href="{{ path('teacher_portal_test_edit', { id: test.id, section: section.id }) }}" class="rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 transition hover:bg-gray-50">
                                    Modifier le test
                                </a>
                                <a href="{{ path('teacher_portal_grade_new', { id: test.id, section: section.id }) }}" class="rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-blue-700">
                                    Saisir les notes
                                </a>
                            </div>
                        </article>
                    {% endfor %}
                </div>
            {% else %}
                <div class="rounded-md border border-dashed border-gray-300 bg-gray-50 p-6 text-gray-600">
                    Aucun test n'a encore été créé pour cet enseignant.
                </div>
            {% endif %}
        </section>
    </div>
</div>
{% endblock %}