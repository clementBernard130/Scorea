{% extends 'base.html.twig' %}

{% block title %}{{ pageTitle }} - Scorea{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-100 text-gray-900">
    <div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 lg:px-8">
        <header class="mb-6 flex flex-wrap items-center justify-between gap-3 rounded-md bg-white px-6 py-4 shadow-md">
            <div>
                <p class="text-xs uppercase tracking-wide text-gray-500">Espace enseignant</p>
                <h1 class="text-2xl font-semibold text-gray-900">{{ pageTitle }}</h1>
            </div>
            <a href="{{ section ? path('app_class_show', { id: section.id }) : path('app_home') }}" class="rounded-md border border-gray-300 bg-white px-4 py-2 font-medium text-gray-700 transition hover:bg-gray-50">
                Retour
            </a>
        </header>

        <section class="rounded-md bg-white p-6 shadow-md sm:p-8">
            {{ form_start(form, { action: formAction, method: 'POST' }) }}
                <div class="grid gap-5">
                    <div>
                        {{ form_label(form.subject, null, {'label_attr': {'class': 'mb-2 block text-sm font-semibold text-gray-800'}}) }}
                        {{ form_widget(form.subject, {'attr': {'class': 'w-full rounded-md border border-gray-300 bg-white px-3 py-2'}}) }}
                        {{ form_errors(form.subject) }}
                    </div>
                    <div>
                        {{ form_label(form.testDate, null, {'label_attr': {'class': 'mb-2 block text-sm font-semibold text-gray-800'}}) }}
                        {{ form_widget(form.testDate, {'attr': {'class': 'w-full rounded-md border border-gray-300 bg-white px-3 py-2'}}) }}
                        {{ form_errors(form.testDate) }}
                    </div>
                    <div>
                        {{ form_label(form.comment, null, {'label_attr': {'class': 'mb-2 block text-sm font-semibold text-gray-800'}}) }}
                        {{ form_widget(form.comment, {'attr': {'class': 'min-h-32 w-full rounded-md border border-gray-300 bg-white px-3 py-2'}}) }}
                        {{ form_errors(form.comment) }}
                    </div>
                </div>

                <div class="mt-6 flex flex-wrap items-center gap-3">
                    <button type="submit" class="rounded-md bg-blue-600 px-5 py-3 font-medium text-white transition hover:bg-blue-700">
                        {{ submitLabel }}
                    </button>
                    <a href="{{ section ? path('app_class_show', { id: section.id }) : path('app_home') }}" class="rounded-md border border-gray-300 bg-white px-5 py-3 font-medium text-gray-700 transition hover:bg-gray-50">
                        Annuler
                    </a>
                </div>
            {{ form_end(form) }}
        </section>
    </div>
</div>
{% endblock %}