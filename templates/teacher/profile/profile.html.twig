{% extends 'base.html.twig' %}

{% block title %}Mon profil enseignant{% endblock %}

{% block body %}
<div class="min-h-screen bg-white px-4 py-10">
    <div class="mx-auto max-w-6xl">
        <header class="mb-6 flex flex-col gap-4 rounded-[28px] border border-white/70 bg-white/85 p-6 shadow-[0_18px_45px_rgba(15,23,42,0.08)] backdrop-blur md:flex-row md:items-center md:justify-between md:p-8">
            <div>
                <p class="text-xs font-bold uppercase tracking-[0.22em] text-stone-500">Espace enseignant</p>
                <h1 class="mt-1 text-3xl font-black tracking-tight text-stone-900 md:text-4xl">Mon profil</h1>
            </div>

            <div class="flex flex-wrap items-center gap-3">
                <a href="{{ path('app_home') }}" class="inline-flex items-center justify-center rounded-full border border-stone-300 bg-white px-5 py-3 text-sm font-bold text-stone-700 transition hover:bg-stone-50">
                    Mon espace
                </a>
                <a href="{{ path('teacher_portal_tests_index') }}" class="inline-flex items-center justify-center rounded-full border border-stone-300 bg-white px-5 py-3 text-sm font-bold text-stone-700 transition hover:bg-stone-50">
                    Mes évaluations
                </a>
            </div>
        </header>

        <section class="mb-6 grid gap-4">
            <article class="rounded-[24px] border border-white/70 bg-white/90 px-5 py-4 shadow-[0_18px_45px_rgba(15,23,42,0.08)] backdrop-blur">
                <p class="text-xs font-bold uppercase tracking-[0.22em] text-stone-500">Nom complet</p>
                <p class="mt-2 text-lg font-black text-stone-900">{{ teacher.lastName|upper }} {{ teacher.firstName }}</p>
            </article>

            <article class="rounded-[24px] border border-white/70 bg-white/90 px-5 py-4 shadow-[0_18px_45px_rgba(15,23,42,0.08)] backdrop-blur">
                <p class="text-xs font-bold uppercase tracking-[0.22em] text-stone-500">Matières</p>
                <div class="mt-2 flex flex-wrap items-center gap-2">
                    <span class="inline-flex items-center rounded-full border border-amber-200 bg-amber-100 px-3 py-1 text-sm font-black text-amber-800">
                        {{ subjectNames is not empty ? subjectNames|length : 0 }}
                    </span>
                    {% if subjectNames is not empty %}
                        <div class="flex flex-wrap gap-2">
                            {% for subjectName in subjectNames %}
                                <span class="inline-flex items-center rounded-full border border-stone-200 bg-white px-3 py-1 text-xs font-semibold text-stone-700">{{ subjectName }}</span>
                            {% endfor %}
                        </div>
                    {% else %}
                        <span class="text-sm text-stone-500">Aucune matière renseignée</span>
                    {% endif %}
                </div>
            </article>
        </section>

        <section class="grid gap-4">
            <article class="col-span-full rounded-[24px] border border-white/70 bg-white p-5 shadow-[0_18px_45px_rgba(15,23,42,0.08)] backdrop-blur">
                <p class="mb-3 text-xs font-bold uppercase tracking-[0.18em] text-stone-400">Identité</p>
                <dl class="grid gap-3">
                    <div class="grid gap-1 rounded-2xl border border-stone-200 bg-white p-4">
                        <dt class="text-xs font-bold uppercase tracking-[0.18em] text-stone-500">Nom d'utilisateur</dt>
                        <dd class="text-sm font-semibold text-stone-900">{{ teacher.username }}</dd>
                    </div>
                    <div class="grid gap-1 rounded-2xl border border-stone-200 bg-white p-4">
                        <dt class="text-xs font-bold uppercase tracking-[0.18em] text-stone-500">Nom</dt>
                        <dd class="text-sm font-semibold text-stone-900">{{ teacher.lastName }}</dd>
                    </div>
                    <div class="grid gap-1 rounded-2xl border border-stone-200 bg-white p-4">
                        <dt class="text-xs font-bold uppercase tracking-[0.18em] text-stone-500">Prénom</dt>
                        <dd class="text-sm font-semibold text-stone-900">{{ teacher.firstName }}</dd>
                    </div>
                    <div class="grid gap-1 rounded-2xl border border-stone-200 bg-white p-4">
                        <dt class="text-xs font-bold uppercase tracking-[0.18em] text-stone-500">Email</dt>
                        <dd class="text-sm font-semibold text-stone-900">{{ teacher.email ?: 'Non renseigné' }}</dd>
                    </div>
                </dl>
            </article>
        </section>

        <section class="mt-4 rounded-[24px] border border-white/70 bg-white/90 p-5 shadow-[0_18px_45px_rgba(15,23,42,0.08)] backdrop-blur">
            <div class="mb-3 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                <div>
                    <p class="text-xs font-bold uppercase tracking-[0.18em] text-stone-400">Enseignement</p>
                    <h2 class="mt-1 text-xl font-bold text-stone-900">Classes & formations </h2>
                </div>
                <p class="text-sm text-stone-500">{{ meta.sectionCount }} section(s) - {{ meta.subjectCount }} matière(s) - {{ meta.testCount }} évaluation(s)</p>
            </div>

            {% if sections is empty %}
                <div class="rounded-2xl border border-dashed border-amber-200 bg-stone-50/70 p-6 text-stone-600">
                    Aucune section n'est associée à votre compte.
                </div>
            {% else %}
                <div class="grid gap-3 md:grid-cols-2">
                    {% for section in sections %}
                        <article class="rounded-2xl border border-stone-200 bg-stone-50/70 p-4">
                            <p class="text-sm font-bold text-stone-900">{{ section.name ?: 'Section inconnue' }}</p>
                            <p class="mt-1 text-sm text-stone-600">Formation: {{ section.training ?: 'Non renseignée' }}</p>
                            <p class="mt-1 text-sm text-stone-600">Année: {{ section.academicYear ?: 'Non renseignée' }}</p>
                        </article>
                    {% endfor %}
                </div>
            {% endif %}
        </section>

		<p class="pb-2 text-center text-m italic mt-4 text-slate-500">
            Pour modifier votre profil, merci de contacter un administrateur.
        </p>
    </div>
</div>
{% endblock %}