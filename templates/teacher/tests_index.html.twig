{% extends 'base.html.twig' %}

{% block title %}Mes tests - Scorea{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-100 text-gray-900">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        <header class="mb-8 flex flex-wrap items-center justify-between gap-4 rounded-md bg-white px-6 py-4 shadow-md">
            <div>
                <p class="text-xs uppercase tracking-wide text-gray-500">Espace enseignant</p>
                <h1 class="text-2xl font-semibold text-gray-900">Mes évaluations</h1>
            </div>
            <div class="flex flex-wrap items-center gap-3">
                <a href="{{ path('app_home') }}" class="rounded-md border border-gray-300 bg-white px-4 py-2 font-medium text-gray-700 transition hover:bg-gray-50">
                    Retour
                </a>
                <a href="{{ path('teacher_portal_test_new') }}" class="rounded-md bg-blue-600 px-4 py-2 font-medium text-white transition hover:bg-blue-700">
                    Nouveau test
                </a>
            </div>
        </header>

        <section class="rounded-md bg-white p-6 shadow-md sm:p-8">
            {% if tests is not empty %}
                <div class="space-y-3">
                    {% for test in tests %}
                        <article class="flex flex-col gap-4 rounded-md border border-gray-200 bg-white p-4 shadow-sm sm:flex-row sm:items-center sm:justify-between">
                            <div>
                                <p class="text-xs uppercase tracking-wide text-gray-500">{{ test.testDate|date('d/m/Y') }}</p>
                                <h2 class="mt-1 text-xl font-semibold text-gray-900">{{ test.subject.name }}</h2>
                                <p class="mt-1 text-sm text-gray-600">{{ test.comment ?: 'Aucun commentaire' }}</p>
                            </div>
                            <div class="flex flex-wrap items-center gap-3">
                                <a href="{{ path('teacher_portal_test_edit', { id: test.id }) }}" class="rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 transition hover:bg-gray-50">
                                    Modifier
                                </a>
                                <a href="{{ path('teacher_portal_grade_new', { id: test.id }) }}" class="rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white transition hover:bg-blue-700">
                                    Saisir des notes
                                </a>
                            </div>
                        </article>
                    {% endfor %}
                </div>
            {% else %}
                <div class="rounded-md border border-dashed border-gray-300 bg-gray-50 p-6 text-gray-600">
                    Vous n'avez pas encore créé d'évaluation.
                </div>
            {% endif %}
        </section>
    </div>
</div>
{% endblock %}