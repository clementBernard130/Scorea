{% extends '@EasyAdmin/crud/new.html.twig' %}

{% block configured_head_contents %}
    {{ parent() }}
    <style>
        :root {
            --new-bg-start: #f7f4ee;
            --new-bg-end: #ecf6f4;
            --new-primary: #0e8a7d;
            --new-secondary: #0a5e60;
            --new-accent: #ec6f2f;
            --new-text: #15323a;
            --new-muted: #5f7680;
            --new-surface: #ffffff;
            --new-border: #d9ebe7;
            --new-shadow: rgba(12, 64, 67, 0.14);
        }

        .student-create-page {
            position: relative;
            max-width: 1040px;
            margin: 0 auto;
            display: grid;
            gap: 1rem;
            padding-bottom: 0.75rem;
        }

        .student-create-page::before,
        .student-create-page::after {
            content: '';
            position: absolute;
            z-index: 0;
            border-radius: 999px;
            pointer-events: none;
        }

        .student-create-page::before {
            width: 240px;
            height: 240px;
            top: -40px;
            right: -30px;
            background: radial-gradient(circle at 30% 30%, rgba(236, 111, 47, 0.34), rgba(236, 111, 47, 0));
        }

        .student-create-page::after {
            width: 300px;
            height: 300px;
            bottom: -70px;
            left: -60px;
            background: radial-gradient(circle at 50% 50%, rgba(14, 138, 125, 0.26), rgba(14, 138, 125, 0));
        }

        .student-create-toolbar,
        .student-create-hero,
        .student-create-form-card {
            position: relative;
            z-index: 1;
        }

        .student-create-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.7rem;
            flex-wrap: wrap;
        }

        .student-create-back {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            color: var(--new-text);
            background: color-mix(in srgb, var(--new-bg-end) 60%, #ffffff);
            border: 1px solid var(--new-border);
            border-radius: 12px;
            padding: 0.55rem 0.9rem;
            text-decoration: none;
            font-weight: 600;
            transition: background-color 0.2s ease, border-color 0.2s ease;
        }

        .student-create-back:hover,
        .student-create-back:focus,
        .student-create-back:active,
        .student-create-back:focus-visible {
            color: var(--new-text) !important;
            background: #ffffff !important;
            border-color: color-mix(in srgb, var(--new-primary) 32%, var(--new-border)) !important;
        }

        .student-create-pill {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            padding: 0.35rem 0.7rem;
            border-radius: 999px;
            background: color-mix(in srgb, var(--new-accent) 20%, #ffffff);
            color: color-mix(in srgb, var(--new-accent) 72%, #8a3f19);
            font-size: 0.79rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
        }

        .student-create-hero {
            overflow: hidden;
            border-radius: 18px;
            border: 1px solid color-mix(in srgb, var(--new-primary) 25%, var(--new-border));
            background:
                linear-gradient(130deg, rgba(255, 255, 255, 0.88), rgba(255, 255, 255, 0.44)),
                linear-gradient(130deg, var(--new-bg-start), var(--new-bg-end));
            box-shadow: 0 20px 40px var(--new-shadow);
            padding: 1.3rem;
            animation: cardReveal 420ms ease-out;
        }

        .student-create-hero-grid {
            display: grid;
            grid-template-columns: minmax(220px, 1fr) minmax(180px, 0.7fr);
            gap: 1rem;
            align-items: center;
        }

        .student-create-title {
            margin: 0;
            font-size: clamp(1.3rem, 2.2vw, 1.8rem);
            line-height: 1.12;
            color: var(--new-text);
            letter-spacing: -0.02em;
        }

        .student-create-subtitle {
            margin: 0.55rem 0 0;
            color: var(--new-muted);
            font-size: 0.95rem;
            max-width: 54ch;
        }

        .student-create-kpis {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 0.6rem;
        }

        .student-create-kpi {
            border-radius: 12px;
            border: 1px solid color-mix(in srgb, var(--new-primary) 18%, var(--new-border));
            background: rgba(255, 255, 255, 0.84);
            padding: 0.7rem 0.75rem;
        }

        .student-create-kpi strong {
            display: block;
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--new-muted);
            margin-bottom: 0.2rem;
        }

        .student-create-kpi span {
            font-size: 0.95rem;
            color: var(--new-text);
            font-weight: 700;
        }

        .student-create-form-card {
            border-radius: 18px;
            padding: 1.1rem;
            border: 1px solid color-mix(in srgb, var(--new-primary) 18%, var(--new-border));
            background: var(--new-surface);
            box-shadow: 0 16px 32px rgba(14, 76, 84, 0.1);
            animation: cardReveal 520ms ease-out;
        }

        .student-create-section {
            border-radius: 14px;
            border: 1px solid color-mix(in srgb, var(--new-primary) 16%, var(--new-border));
            background: linear-gradient(180deg, #ffffff, color-mix(in srgb, var(--new-bg-end) 22%, #ffffff));
            padding: 0.95rem;
            transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
        }

        .student-create-section + .student-create-section {
            margin-top: 0.85rem;
        }

        .student-create-section:hover {
            border-color: color-mix(in srgb, var(--new-primary) 38%, var(--new-border));
            box-shadow: 0 12px 20px rgba(9, 93, 93, 0.08);
            transform: translateY(-1px);
        }

        .student-create-section-title {
            margin: 0 0 0.72rem;
            color: var(--new-text);
            font-size: 0.94rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 0.45rem;
            letter-spacing: 0.02em;
            text-transform: uppercase;
        }

        .student-create-section-title::before {
            content: '';
            width: 11px;
            height: 11px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--new-primary), var(--new-accent));
            box-shadow: 0 0 0 4px color-mix(in srgb, var(--new-primary) 22%, transparent);
        }

        .student-create-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 0.8rem;
        }

        .student-create-grid .form-group {
            margin: 0;
        }

        .student-create-form-card .form-label,
        .student-create-form-card label {
            color: color-mix(in srgb, var(--new-text) 88%, #102026);
            font-weight: 700;
            margin-bottom: 0.35rem;
        }

        .student-create-form-card .form-control,
        .student-create-form-card .form-select {
            border-radius: 10px;
            border: 1px solid color-mix(in srgb, var(--new-primary) 18%, var(--new-border));
            min-height: 42px;
            background: #ffffff;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

        .student-create-form-card .form-control:focus,
        .student-create-form-card .form-select:focus {
            border-color: color-mix(in srgb, var(--new-primary) 70%, #0a5e60);
            box-shadow: 0 0 0 0.2rem color-mix(in srgb, var(--new-primary) 22%, transparent);
        }

        .student-create-form-card .form-check {
            margin-bottom: 0.46rem;
            border-radius: 999px;
            border: 1px solid color-mix(in srgb, var(--new-primary) 22%, var(--new-border));
            background: #ffffff;
            padding: 0.48rem 0.75rem 0.48rem 2rem;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

        .student-create-form-card .form-check:hover {
            border-color: color-mix(in srgb, var(--new-accent) 52%, var(--new-border));
            box-shadow: 0 8px 15px rgba(14, 95, 96, 0.08);
        }

        .student-create-form-card .form-check-input {
            margin-top: 0.1rem;
            border: 2px solid color-mix(in srgb, var(--new-primary) 44%, var(--new-border));
        }

        .student-create-form-card .form-check-input:checked {
            background-color: var(--new-primary);
            border-color: var(--new-primary);
        }

        .student-create-form-card .ea-form-actions,
        .student-create-form-card .form-actions {
            border-top: 1px dashed color-mix(in srgb, var(--new-primary) 26%, var(--new-border));
            margin-top: 0.9rem;
            padding-top: 0.9rem;
        }

        .student-create-form-card .btn-primary {
            border: none !important;
            border-radius: 11px !important;
            color: #ffffff !important;
            font-weight: 700;
            background: linear-gradient(135deg, var(--new-primary), var(--new-secondary)) !important;
            box-shadow: 0 10px 18px rgba(9, 94, 96, 0.24);
            padding: 0.55rem 1rem !important;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .student-create-form-card .btn-primary:hover,
        .student-create-form-card .btn-primary:focus,
        .student-create-form-card .btn-primary:active,
        .student-create-form-card .btn-primary:focus-visible {
            transform: translateY(-1px);
            box-shadow: 0 14px 22px rgba(9, 94, 96, 0.3);
            color: #ffffff !important;
        }

        @keyframes cardReveal {
            from {
                opacity: 0;
                transform: translateY(8px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @media (max-width: 780px) {
            .student-create-hero-grid,
            .student-create-grid {
                grid-template-columns: 1fr;
            }

            .student-create-kpis {
                grid-template-columns: 1fr;
            }
        }
    </style>
{% endblock %}

{% set crudController = ea.crud.controllerFqcn|default('') %}
{% set entityName = ea.crud.entityLabelInSingular|default('Utilisateur') %}
{% set entityNameLower = entityName|lower %}

{% set heroTitle = 'Créer un compte ' ~ entityNameLower ~ ' ' %}
{% set heroSubtitle = 'Renseignez les informations obligatoires et rattachez directement les sections pour une gestion immédiate dans le tableau de bord.' %}

{% block main %}
    <div class="student-create-page">
        <div class="student-create-toolbar">
            <a href="{{ ea_url().setAction('index') }}" class="student-create-back">
                <i class="fa fa-arrow-left"></i> Retour à la liste
            </a>
            <span class="student-create-pill"><i class="fa fa-user-graduate"></i> Nouveau profil</span>
        </div>

        <section class="student-create-hero">
            <div class="student-create-hero-grid">
                <div>
                    <h2 class="student-create-title">{{ heroTitle }}</h2>
                    <p class="student-create-subtitle">
                        {{ heroSubtitle }}
                    </p>
                </div>
            </div>
        </section>

        <section class="student-create-form-card">
            {{ form_start(new_form) }}

            <div class="student-create-section">
                <h3 class="student-create-section-title">Identité</h3>
                <div class="student-create-grid">
                    {% if new_form.last_name is defined %}
                        {{ form_row(new_form.last_name) }}
                    {% endif %}
                    {% if new_form.first_name is defined %}
                        {{ form_row(new_form.first_name) }}
                    {% endif %}
                    {% if new_form.email is defined %}
                        {{ form_row(new_form.email) }}
                    {% endif %}
                </div>
            </div>

            <div class="student-create-section">
                <h3 class="student-create-section-title">Sécurité</h3>

                {{- form_label(new_form.password) -}}

                <div style="display: flex; gap: 8px; margin-bottom: 8px; align-items: center;">
                    <div style="position: relative; flex: 1;">
                        {{- form_widget(new_form.password, {
                            attr: {
                                id: 'pwd-main-field',
                                autocomplete: 'new-password',
                                style: 'padding-right: 2.8rem; font-family: monospace; letter-spacing: 0.06em;'
                            }
                        }) -}}
                        <button
                            type="button"
                            id="pwd-toggle-btn"
                            onclick="togglePwdVisibility()"
                            title="Afficher / masquer"
                            style="
                                position: absolute; right: 10px; top: 50%; transform: translateY(-50%);
                                background: none; border: none; cursor: pointer; padding: 0;
                                color: var(--new-muted); font-size: 1rem; line-height: 1;
                            "
                        >
                            <i id="pwd-toggle-icon" class="fa fa-eye"></i>
                        </button>
                    </div>

                    <button type="button" class="btn btn-outline-secondary" onclick="generatePassword()" title="Générer un mot de passe sécurisé">
                        <i class="fa fa-key"></i> Générer
                    </button>
                    <button type="button" class="btn btn-outline-secondary" onclick="copyPassword()" title="Copier">
                        <i class="fa fa-copy"></i>
                    </button>
                </div>

                {{- form_errors(new_form.password) -}}

                <div style="height: 4px; border-radius: 2px; background: #e0e0e0; margin-bottom: 4px; overflow: hidden;">
                    <div id="pwd-strength-bar" style="height: 100%; width: 0; border-radius: 2px; transition: width .3s, background .3s;"></div>
                </div>
                <small id="pwd-strength-label" style="color: #666; display: block; margin-bottom: 6px;">—</small>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 4px 16px; margin-bottom: 4px;">
                    <small><span id="r-len"     class="pwd-rule-dot">●</span> 12 caractères min.</small>
                    <small><span id="r-upper"   class="pwd-rule-dot">●</span> Majuscule</small>
                    <small><span id="r-lower"   class="pwd-rule-dot">●</span> Minuscule</small>
                    <small><span id="r-digit"   class="pwd-rule-dot">●</span> Chiffre</small>
                    <small><span id="r-spec"    class="pwd-rule-dot">●</span> Caractère spécial</small>
                    <small><span id="r-entropy" class="pwd-rule-dot">●</span> Entropie ≥ 80 bits</small>
                </div>
                <small id="pwd-copied-msg" style="color: green; opacity: 0; transition: opacity .3s;">
                    Copié dans le presse-papiers
                </small>
            </div>
            
            {% if new_form.roles is defined %}
                <div class="student-create-section">
                    <h3 class="student-create-section-title">Rôles</h3>
                    {{ form_row(new_form.roles) }}
                </div>
            {% endif %}

            <div class="student-create-section">
                <h3 class="student-create-section-title">Sections</h3>
                {% if new_form.sections is defined %}
                    {{ form_row(new_form.sections) }}
                {% endif %}
            </div>

            {{ form_rest(new_form) }}
            {{ form_end(new_form, { render_rest: false }) }}
        </section>
    </div>

{% block configured_javascripts %}
    {{ parent() }}
    <style>
        .pwd-rule-dot { color: #ccc; transition: color .2s; }
        .pwd-rule-dot.ok { color: #3B6D11; }
    </style>
    <script src="{{ asset('assets/admin/password-generator.js') }}"></script>
{% endblock %}
{% endblock %}
