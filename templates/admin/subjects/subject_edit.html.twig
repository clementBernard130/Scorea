{% extends '@EasyAdmin/crud/edit.html.twig' %}

{% block configured_head_contents %}
    {{ parent() }}
    <style>
        :root {
            --subject-edit-bg-start: #f6f1e8;
            --subject-edit-bg-end: #e8f4f1;
            --subject-edit-primary: #0f7e73;
            --subject-edit-secondary: #0a5d58;
            --subject-edit-accent: #d67827;
            --subject-edit-text: #16343c;
            --subject-edit-muted: #5d727b;
            --subject-edit-surface: #ffffff;
            --subject-edit-border: #d8e8e3;
        }

        .subject-edit-page {
            max-width: 980px;
            margin: 0 auto;
            display: grid;
            gap: 1rem;
        }

        .subject-edit-toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 0.7rem;
        }

        .subject-edit-back {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            color: var(--subject-edit-text);
            background: color-mix(in srgb, var(--subject-edit-bg-end) 60%, #ffffff);
            border: 1px solid var(--subject-edit-border);
            border-radius: 12px;
            padding: 0.55rem 0.9rem;
            text-decoration: none;
            font-weight: 600;
        }

        .subject-edit-pill {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            padding: 0.35rem 0.7rem;
            border-radius: 999px;
            background: color-mix(in srgb, var(--subject-edit-accent) 20%, #ffffff);
            color: color-mix(in srgb, var(--subject-edit-accent) 72%, #8a3f19);
            font-size: 0.79rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
        }

        .subject-edit-hero {
            overflow: hidden;
            border-radius: 18px;
            border: 1px solid color-mix(in srgb, var(--subject-edit-primary) 25%, var(--subject-edit-border));
            background:
                linear-gradient(130deg, rgba(255, 255, 255, 0.88), rgba(255, 255, 255, 0.44)),
                linear-gradient(130deg, var(--subject-edit-bg-start), var(--subject-edit-bg-end));
            box-shadow: 0 20px 40px rgba(12, 64, 67, 0.14);
            padding: 1.3rem;
        }

        .subject-edit-title {
            margin: 0;
            font-size: clamp(1.3rem, 2.2vw, 1.8rem);
            line-height: 1.12;
            color: var(--subject-edit-text);
        }

        .subject-edit-subtitle {
            margin: 0.55rem 0 0;
            color: var(--subject-edit-muted);
            font-size: 0.95rem;
            max-width: 58ch;
        }

        .subject-edit-form-card {
            border-radius: 18px;
            padding: 1.1rem;
            border: 1px solid color-mix(in srgb, var(--subject-edit-primary) 18%, var(--subject-edit-border));
            background: var(--subject-edit-surface);
            box-shadow: 0 16px 32px rgba(14, 76, 84, 0.1);
        }

        .subject-edit-section {
            border-radius: 14px;
            border: 1px solid color-mix(in srgb, var(--subject-edit-primary) 16%, var(--subject-edit-border));
            background: linear-gradient(180deg, #ffffff, color-mix(in srgb, var(--subject-edit-bg-end) 22%, #ffffff));
            padding: 0.95rem;
        }

        .subject-edit-section-title {
            margin: 0 0 0.72rem;
            color: var(--subject-edit-text);
            font-size: 0.94rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 0.45rem;
            text-transform: uppercase;
            letter-spacing: 0.02em;
        }

        .subject-edit-section-title::before {
            content: '';
            width: 11px;
            height: 11px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--subject-edit-primary), var(--subject-edit-accent));
            box-shadow: 0 0 0 4px color-mix(in srgb, var(--subject-edit-primary) 22%, transparent);
        }

        .subject-edit-form-card .form-label,
        .subject-edit-form-card label {
            color: color-mix(in srgb, var(--subject-edit-text) 88%, #102026);
            font-weight: 700;
            margin-bottom: 0.35rem;
        }

        .subject-edit-form-card .form-control,
        .subject-edit-form-card .form-select {
            border-radius: 10px;
            border: 1px solid color-mix(in srgb, var(--subject-edit-primary) 18%, var(--subject-edit-border));
            min-height: 42px;
            background: #ffffff;
        }

        .subject-edit-form-card textarea.form-control {
            min-height: 120px;
        }

        .subject-edit-form-card .ea-form-actions,
        .subject-edit-form-card .form-actions {
            border-top: 1px dashed color-mix(in srgb, var(--subject-edit-primary) 26%, var(--subject-edit-border));
            margin-top: 0.9rem;
            padding-top: 0.9rem;
        }

        .btn-primary {
            border: none !important;
            color: #fff !important;
            border-radius: 11px !important;
            font-weight: 700;
            background: linear-gradient(135deg, var(--subject-edit-primary), var(--subject-edit-secondary)) !important;
            box-shadow: 0 10px 18px rgba(9, 94, 96, 0.24);
            padding: 0.55rem 1rem !important;
        }
    </style>
{% endblock %}

{% block main %}
    <div class="subject-edit-page">
        <div class="subject-edit-toolbar">
            <a href="{{ ea_url().setAction('index') }}" class="subject-edit-back">
                <i class="fa fa-arrow-left"></i> Retour a la liste
            </a>
            <span class="subject-edit-pill"><i class="fa fa-pen"></i> Edition</span>
        </div>

        <section class="subject-edit-hero">
            <h2 class="subject-edit-title">Modifier la matiere</h2>
            <p class="subject-edit-subtitle">Mettez a jour les informations de la matiere.</p>
        </section>

        <section class="subject-edit-form-card">
            {{ form_start(edit_form) }}

            <div class="subject-edit-section">
                <h3 class="subject-edit-section-title">Informations generales</h3>
                {% if edit_form.name is defined %}
                    {{ form_row(edit_form.name) }}
                {% endif %}
                {% if edit_form.description is defined %}
                    {{ form_row(edit_form.description) }}
                {% endif %}
                {% if edit_form.coefficient is defined %}
                    {{ form_row(edit_form.coefficient) }}
                {% endif %}
            </div>

            {{ form_rest(edit_form) }}
            {{ form_end(edit_form, { render_rest: false }) }}
        </section>
    </div>
{% endblock %}
