{% extends '@EasyAdmin/crud/new.html.twig' %}

{% block configured_head_contents %}
    {{ parent() }}
    <style>
        :root {
            --new-bg-start: #f7f4ee;
            --new-bg-end: #ecf6f4;
            --new-primary: #0e8a7d;
            --new-secondary: #0a5e60;
            --new-accent: #ec6f2f;
            --new-text: #15323a;
            --new-muted: #5f7680;
            --new-surface: #ffffff;
            --new-border: #d9ebe7;
            --new-shadow: rgba(12, 64, 67, 0.14);
        }

        .training-create-page {
            position: relative;
            max-width: 1040px;
            margin: 0 auto;
            display: grid;
            gap: 1rem;
            padding-bottom: 0.75rem;
        }

        .training-create-page::before,
        .training-create-page::after {
            content: '';
            position: absolute;
            z-index: 0;
            border-radius: 999px;
            pointer-events: none;
        }

        .training-create-page::before {
            width: 240px;
            height: 240px;
            top: -40px;
            right: -30px;
            background: radial-gradient(circle at 30% 30%, rgba(236, 111, 47, 0.34), rgba(236, 111, 47, 0));
        }

        .training-create-page::after {
            width: 300px;
            height: 300px;
            bottom: -70px;
            left: -60px;
            background: radial-gradient(circle at 50% 50%, rgba(14, 138, 125, 0.26), rgba(14, 138, 125, 0));
        }

        .training-create-toolbar,
        .training-create-hero,
        .training-create-form-card {
            position: relative;
            z-index: 1;
        }

        .training-create-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.7rem;
            flex-wrap: wrap;
        }

        .training-create-back {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            color: var(--new-text);
            background: color-mix(in srgb, var(--new-bg-end) 60%, #ffffff);
            border: 1px solid var(--new-border);
            border-radius: 12px;
            padding: 0.55rem 0.9rem;
            text-decoration: none;
            font-weight: 600;
            transition: background-color 0.2s ease, border-color 0.2s ease;
        }

        .training-create-back:hover,
        .training-create-back:focus,
        .training-create-back:active,
        .training-create-back:focus-visible {
            color: var(--new-text) !important;
            background: #ffffff !important;
            border-color: color-mix(in srgb, var(--new-primary) 32%, var(--new-border)) !important;
        }

        .training-create-pill {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            padding: 0.35rem 0.7rem;
            border-radius: 999px;
            background: color-mix(in srgb, var(--new-accent) 20%, #ffffff);
            color: color-mix(in srgb, var(--new-accent) 72%, #8a3f19);
            font-size: 0.79rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
        }

        .training-create-hero {
            overflow: hidden;
            border-radius: 18px;
            border: 1px solid color-mix(in srgb, var(--new-primary) 25%, var(--new-border));
            background:
                linear-gradient(130deg, rgba(255, 255, 255, 0.88), rgba(255, 255, 255, 0.44)),
                linear-gradient(130deg, var(--new-bg-start), var(--new-bg-end));
            box-shadow: 0 20px 40px var(--new-shadow);
            padding: 1.3rem;
            animation: cardReveal 420ms ease-out;
        }

        .training-create-title {
            margin: 0;
            font-size: clamp(1.3rem, 2.2vw, 1.8rem);
            line-height: 1.12;
            color: var(--new-text);
            letter-spacing: -0.02em;
        }

        .training-create-subtitle {
            margin: 0.55rem 0 0;
            color: var(--new-muted);
            font-size: 0.95rem;
            max-width: 54ch;
        }

        .training-create-form-card {
            border-radius: 18px;
            padding: 1.1rem;
            border: 1px solid color-mix(in srgb, var(--new-primary) 18%, var(--new-border));
            background: var(--new-surface);
            box-shadow: 0 16px 32px rgba(14, 76, 84, 0.1);
            animation: cardReveal 520ms ease-out;
        }

        .training-create-section {
            border-radius: 14px;
            border: 1px solid color-mix(in srgb, var(--new-primary) 16%, var(--new-border));
            background: linear-gradient(180deg, #ffffff, color-mix(in srgb, var(--new-bg-end) 22%, #ffffff));
            padding: 0.95rem;
            transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
        }

        .training-create-section + .training-create-section {
            margin-top: 0.85rem;
        }

        .training-create-section:hover {
            border-color: color-mix(in srgb, var(--new-primary) 38%, var(--new-border));
            box-shadow: 0 12px 20px rgba(9, 93, 93, 0.08);
            transform: translateY(-1px);
        }

        .training-create-section-title {
            margin: 0 0 0.72rem;
            color: var(--new-text);
            font-size: 0.94rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 0.45rem;
            letter-spacing: 0.02em;
            text-transform: uppercase;
        }

        .training-create-section-title::before {
            content: '';
            width: 11px;
            height: 11px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--new-primary), var(--new-accent));
            box-shadow: 0 0 0 4px color-mix(in srgb, var(--new-primary) 22%, transparent);
        }

        .training-create-form-card .form-label,
        .training-create-form-card label {
            color: color-mix(in srgb, var(--new-text) 88%, #102026);
            font-weight: 700;
            margin-bottom: 0.35rem;
        }

        .training-create-form-card .form-control,
        .training-create-form-card .form-select {
            border-radius: 10px;
            border: 1px solid color-mix(in srgb, var(--new-primary) 18%, var(--new-border));
            min-height: 42px;
            background: #ffffff;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

        .training-create-form-card .form-control:focus,
        .training-create-form-card .form-select:focus {
            border-color: color-mix(in srgb, var(--new-primary) 70%, #0a5e60);
            box-shadow: 0 0 0 0.2rem color-mix(in srgb, var(--new-primary) 22%, transparent);
        }

        .training-create-form-card .ea-form-actions,
        .training-create-form-card .form-actions {
            border-top: 1px dashed color-mix(in srgb, var(--new-primary) 26%, var(--new-border));
            margin-top: 0.9rem;
            padding-top: 0.9rem;
        }

        .training-create-form-card .btn-primary {
            border: none !important;
            border-radius: 11px !important;
            color: #ffffff !important;
            font-weight: 700;
            background: linear-gradient(135deg, var(--new-primary), var(--new-secondary)) !important;
            box-shadow: 0 10px 18px rgba(9, 94, 96, 0.24);
            padding: 0.55rem 1rem !important;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .training-create-form-card .btn-primary:hover,
        .training-create-form-card .btn-primary:focus,
        .training-create-form-card .btn-primary:active,
        .training-create-form-card .btn-primary:focus-visible {
            transform: translateY(-1px);
            box-shadow: 0 14px 22px rgba(9, 94, 96, 0.3);
            color: #ffffff !important;
        }

        .training-create-note {
            margin: 0;
            color: var(--new-muted);
            font-size: 0.88rem;
        }

        @keyframes cardReveal {
            from {
                opacity: 0;
                transform: translateY(8px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
{% endblock %}

{% block main %}
    <div class="training-create-page">
        <div class="training-create-toolbar">
            <a href="{{ ea_url().setAction('index') }}" class="training-create-back">
                <i class="fa fa-arrow-left"></i> Retour
            </a>
            <span class="training-create-pill"><i class="fa fa-graduation-cap"></i> Nouvelle formation</span>
        </div>

        <section class="training-create-hero">
            <h2 class="training-create-title">Créer une formation</h2>
            <p class="training-create-subtitle">
                Renseignez les informations principales.
            </p>
        </section>

        <section class="training-create-form-card">
            {{ form_start(new_form) }}

            <div class="training-create-section">
                <h3 class="training-create-section-title">Informations générales</h3>
                {% if new_form.name is defined %}
                    {{ form_row(new_form.name) }}
                {% endif %}
                {% if new_form.description is defined %}
                    {{ form_row(new_form.description) }}
                {% endif %}
            </div>

            <div class="training-create-section">
                <h3 class="training-create-section-title">Blocs de compétences</h3>
                <p class="training-create-note">
                    Les blocs peuvent être rattachés lors de la modification de la formation.
                </p>
            </div>

            {{ form_rest(new_form) }}
            {{ form_end(new_form, { render_rest: false }) }}
        </section>
    </div>
{% endblock %}
