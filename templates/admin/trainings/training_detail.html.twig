{% extends '@EasyAdmin/page/content.html.twig' %}

{% block configured_head_contents %}
    {{ parent() }}
    <style>
        :root {
            --detail-bg-start: #f7f4ee;
            --detail-bg-end: #ecf6f4;
            --detail-primary: #0e8a7d;
            --detail-secondary: #0a5e60;
            --detail-accent: #ec6f2f;
            --detail-text: #15323a;
            --detail-muted: #5f7680;
            --detail-surface: #ffffff;
            --detail-border: #d9ebe7;
            --detail-shadow: rgba(12, 64, 67, 0.14);
        }

        .training-detail-page {
            max-width: 1040px;
            margin: 0 auto;
            display: grid;
            gap: 1rem;
        }

        .training-detail-toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 0.7rem;
        }

        .training-detail-toolbar .btn {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            border-radius: 12px;
            padding: 0.55rem 0.9rem;
            text-decoration: none;
        }

        .btn-training-back {
            color: var(--detail-text);
            background: color-mix(in srgb, var(--detail-bg-end) 60%, #ffffff);
            border: 1px solid var(--detail-border);
        }

        .btn-training-back:hover,
        .btn-training-back:focus,
        .btn-training-back:active,
        .btn-training-back:focus-visible {
            color: var(--detail-text) !important;
            background: #ffffff !important;
            border-color: color-mix(in srgb, var(--detail-primary) 32%, var(--detail-border)) !important;
        }

        .btn-training-edit {
            border: none;
            color: #ffffff;
            background: linear-gradient(135deg, var(--detail-primary), var(--detail-secondary));
            box-shadow: 0 10px 18px rgba(9, 94, 96, 0.24);
        }

        .btn-training-edit:hover,
        .btn-training-edit:focus,
        .btn-training-edit:active,
        .btn-training-edit:focus-visible {
            color: #ffffff !important;
            background: linear-gradient(135deg, var(--detail-primary), var(--detail-secondary)) !important;
        }

        .training-detail-hero {
            overflow: hidden;
            border-radius: 18px;
            border: 1px solid color-mix(in srgb, var(--detail-primary) 25%, var(--detail-border));
            background:
                linear-gradient(130deg, rgba(255, 255, 255, 0.88), rgba(255, 255, 255, 0.44)),
                linear-gradient(130deg, var(--detail-bg-start), var(--detail-bg-end));
            box-shadow: 0 20px 40px var(--detail-shadow);
            padding: 1.3rem;
        }

        .training-detail-title {
            margin: 0;
            color: var(--detail-text);
            font-size: clamp(1.3rem, 2.2vw, 1.8rem);
        }

        .training-detail-subtitle {
            margin: 0.5rem 0 0;
            color: var(--detail-muted);
        }

        .training-detail-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 0.85rem;
        }

        .training-detail-card {
            border-radius: 14px;
            border: 1px solid color-mix(in srgb, var(--detail-primary) 16%, var(--detail-border));
            background: var(--detail-surface);
            box-shadow: 0 10px 20px rgba(9, 93, 93, 0.08);
            padding: 1rem;
        }

        .training-detail-card h3 {
            margin: 0 0 0.7rem;
            font-size: 0.96rem;
            color: var(--detail-text);
            text-transform: uppercase;
            letter-spacing: 0.03em;
        }

        .training-detail-kpis {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 0.6rem;
        }

        .training-detail-kpi {
            border-radius: 10px;
            border: 1px solid color-mix(in srgb, var(--detail-primary) 18%, var(--detail-border));
            background: color-mix(in srgb, var(--detail-bg-end) 18%, #ffffff);
            padding: 0.6rem 0.7rem;
        }

        .training-detail-kpi strong {
            display: block;
            color: var(--detail-muted);
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .training-detail-kpi span {
            font-size: 1.02rem;
            color: var(--detail-text);
            font-weight: 700;
        }

        .training-chip-wrap {
            display: flex;
            flex-wrap: wrap;
            gap: 0.45rem;
        }

        .training-chip {
            display: inline-flex;
            align-items: center;
            gap: 0.3rem;
            padding: 0.35rem 0.7rem;
            border-radius: 999px;
            background: color-mix(in srgb, var(--detail-accent) 16%, #ffffff);
            border: 1px solid color-mix(in srgb, var(--detail-accent) 26%, var(--detail-border));
            color: color-mix(in srgb, var(--detail-accent) 75%, #7e3a17);
            font-weight: 700;
            font-size: 0.8rem;
        }

        .training-muted {
            margin: 0;
            color: var(--detail-muted);
            font-style: italic;
        }

        .danger-zone {
            border: 1px solid #f2c3c3;
            background: linear-gradient(180deg, #fff7f7, #fff0f0);
        }

        .danger-zone-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.8rem;
            flex-wrap: wrap;
        }

        .danger-zone-title {
            margin: 0;
            font-size: 1rem;
            color: #8d1f1f;
            font-weight: 700;
        }

        .btn-danger-zone {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            border: none;
            border-radius: 10px;
            padding: 0.55rem 0.9rem;
            color: #fff;
            text-decoration: none;
            background: linear-gradient(135deg, #d73a49, #9e1f2d);
            box-shadow: 0 10px 20px rgba(153, 28, 39, 0.2);
        }

        .btn-danger-zone:hover,
        .btn-danger-zone:focus,
        .btn-danger-zone:active,
        .btn-danger-zone:focus-visible {
            color: #fff !important;
            background: linear-gradient(135deg, #bf2f3c, #851926) !important;
        }

        .danger-zone .ea-delete-form {
            margin: 0;
        }

        .danger-zone .ea-delete-form .action-delete,
        .danger-zone .ea-delete-form button[type='submit'] {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            border: none !important;
            border-radius: 10px !important;
            padding: 0.55rem 0.9rem !important;
            color: #fff !important;
            text-decoration: none;
            background: linear-gradient(135deg, #d73a49, #9e1f2d) !important;
            box-shadow: 0 10px 20px rgba(153, 28, 39, 0.2);
        }

        .danger-zone .ea-delete-form .action-delete:hover,
        .danger-zone .ea-delete-form .action-delete:focus,
        .danger-zone .ea-delete-form .action-delete:active,
        .danger-zone .ea-delete-form button[type='submit']:hover,
        .danger-zone .ea-delete-form button[type='submit']:focus,
        .danger-zone .ea-delete-form button[type='submit']:active {
            color: #fff !important;
            background: linear-gradient(135deg, #bf2f3c, #851926) !important;
        }

        @media (max-width: 780px) {
            .training-detail-grid,
            .training-detail-kpis {
                grid-template-columns: 1fr;
            }
        }
    </style>
{% endblock %}

{% block content_title %}Fiche formation{% endblock %}

{% block main %}
    <div class="training-detail-page">
        <div class="training-detail-toolbar">
            <a href="{{ ea_url().setAction('index') }}" class="btn btn-training-back">
                <i class="fa fa-arrow-left"></i> Retour a la liste
            </a>
            <a href="{{ ea_url().setAction('edit').setEntityId(entity.primaryKeyValue) }}" class="btn btn-training-edit">
                <i class="fa fa-pen"></i> Modifier
            </a>
        </div>

        <section class="training-detail-hero">
            <h2 class="training-detail-title">{{ entity.instance.name|default('Formation sans nom') }}</h2>
            <p class="training-detail-subtitle">Vue detaillée de la formation et de ses rattachements.</p>
        </section>

        <div class="training-detail-grid">
            <section class="training-detail-card">
                <h3>Description</h3>
                {% if entity.instance.description is not empty %}
                    <p>{{ entity.instance.description|nl2br }}</p>
                {% else %}
                    <p class="training-muted">Aucune description renseignée.</p>
                {% endif %}
            </section>

            <section class="training-detail-card">
                <h3>Indicateurs</h3>
                <div class="training-detail-kpis">
                    <div class="training-detail-kpi">
                        <strong>Sections</strong>
                        <span>{{ entity.instance.sections|length }}</span>
                    </div>
                    <div class="training-detail-kpi">
                        <strong>Blocs</strong>
                        <span>{{ entity.instance.skillUnits|length }}</span>
                    </div>
                </div>
            </section>
        </div>

        <section class="training-detail-card">
            <h3>Sections rattachées</h3>
            {% if entity.instance.sections|length > 0 %}
                <div class="training-chip-wrap">
                    {% for section in entity.instance.sections %}
                        <span class="training-chip"><i class="fa fa-layer-group"></i> {{ section.name }}</span>
                    {% endfor %}
                </div>
            {% else %}
                <p class="training-muted">Aucune section rattachée.</p>
            {% endif %}
        </section>

        <section class="training-detail-card">
            <h3>Blocs de compétences</h3>
            {% if entity.instance.skillUnits|length > 0 %}
                <div class="training-chip-wrap">
                    {% for skillUnit in entity.instance.skillUnits %}
                        <span class="training-chip"><i class="fa fa-cube"></i> {{ skillUnit }}</span>
                    {% endfor %}
                </div>
            {% else %}
                <p class="training-muted">Aucun bloc rattaché.</p>
            {% endif %}
        </section>

        <section class="training-detail-card danger-zone">
            <div class="danger-zone-header">
                <h3 class="danger-zone-title">Zone de danger</h3>
                {% set deleteUrl = ea_url().setAction('delete').setEntityId(entity.primaryKeyValue) %}
                <button
                    type="button"
                    class="btn-danger-zone"
                    data-action-name="delete"
                    formaction="{{ deleteUrl }}"
                    data-bs-toggle="modal"
                    data-bs-target="#modal-delete"
                >
                    <i class="fa fa-trash"></i>
                    <span>Supprimer la formation</span>
                </button>
                {{ include('@EasyAdmin/crud/includes/_delete_form.html.twig', { entity_id: entity.primaryKeyValue }, with_context: false) }}
            </div>
        </section>
    </div>
{% endblock %}
