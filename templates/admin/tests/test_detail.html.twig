{% extends '@EasyAdmin/page/content.html.twig' %}

{% block configured_head_contents %}
    {{ parent() }}
    <style>
        :root {
            --test-detail-bg-start: #f7f4ee;
            --test-detail-bg-end: #ecf6f4;
            --test-detail-primary: #0e8a7d;
            --test-detail-secondary: #0a5e60;
            --test-detail-accent: #ec6f2f;
            --test-detail-text: #15323a;
            --test-detail-muted: #5f7680;
            --test-detail-surface: #ffffff;
            --test-detail-border: #d9ebe7;
            --test-detail-shadow: rgba(12, 64, 67, 0.14);
        }

        .test-detail-page {
            max-width: 1040px;
            margin: 0 auto;
            display: grid;
            gap: 1rem;
        }

        .test-detail-toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 0.7rem;
        }

        .test-detail-toolbar .btn {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            border-radius: 12px;
            padding: 0.55rem 0.9rem;
            text-decoration: none;
        }

        .btn-test-back {
            color: var(--test-detail-text);
            background: color-mix(in srgb, var(--test-detail-bg-end) 60%, #ffffff);
            border: 1px solid var(--test-detail-border);
        }

        .btn-test-back:hover,
        .btn-test-back:focus,
        .btn-test-back:active,
        .btn-test-back:focus-visible {
            color: var(--test-detail-text) !important;
            background: #ffffff !important;
            border-color: color-mix(in srgb, var(--test-detail-primary) 32%, var(--test-detail-border)) !important;
        }

        .btn-test-edit {
            border: none;
            color: #ffffff;
            background: linear-gradient(135deg, var(--test-detail-primary), var(--test-detail-secondary));
            box-shadow: 0 10px 18px rgba(9, 94, 96, 0.24);
        }

        .btn-test-edit:hover,
        .btn-test-edit:focus,
        .btn-test-edit:active,
        .btn-test-edit:focus-visible {
            color: #ffffff !important;
            background: linear-gradient(135deg, var(--test-detail-primary), var(--test-detail-secondary)) !important;
        }

        .test-detail-hero {
            overflow: hidden;
            border-radius: 18px;
            border: 1px solid color-mix(in srgb, var(--test-detail-primary) 25%, var(--test-detail-border));
            background:
                linear-gradient(130deg, rgba(255, 255, 255, 0.88), rgba(255, 255, 255, 0.44)),
                linear-gradient(130deg, var(--test-detail-bg-start), var(--test-detail-bg-end));
            box-shadow: 0 20px 40px var(--test-detail-shadow);
            padding: 1.3rem;
        }

        .test-detail-title {
            margin: 0;
            color: var(--test-detail-text);
            font-size: clamp(1.3rem, 2.2vw, 1.8rem);
        }

        .test-detail-subtitle {
            margin: 0.5rem 0 0;
            color: var(--test-detail-muted);
        }

        .test-detail-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 0.85rem;
        }

        .test-detail-card {
            border-radius: 14px;
            border: 1px solid color-mix(in srgb, var(--test-detail-primary) 16%, var(--test-detail-border));
            background: var(--test-detail-surface);
            box-shadow: 0 10px 20px rgba(9, 93, 93, 0.08);
            padding: 1rem;
        }

        .test-detail-card h3 {
            margin: 0 0 0.7rem;
            font-size: 0.96rem;
            color: var(--test-detail-text);
            text-transform: uppercase;
            letter-spacing: 0.03em;
        }

        .test-chip-wrap {
            display: flex;
            flex-wrap: wrap;
            gap: 0.45rem;
        }

        .test-chip {
            display: inline-flex;
            align-items: center;
            gap: 0.3rem;
            padding: 0.35rem 0.7rem;
            border-radius: 999px;
            background: color-mix(in srgb, var(--test-detail-accent) 16%, #ffffff);
            border: 1px solid color-mix(in srgb, var(--test-detail-accent) 26%, var(--test-detail-border));
            color: color-mix(in srgb, var(--test-detail-accent) 75%, #7e3a17);
            font-weight: 700;
            font-size: 0.8rem;
        }

        .test-user-link {
            text-decoration: none;
            color: inherit;
            transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
        }

        .test-user-link:hover,
        .test-user-link:focus,
        .test-user-link:active,
        .test-user-link:focus-visible {
            color: inherit !important;
            transform: translateY(-1px);
            border-color: color-mix(in srgb, var(--test-detail-primary) 34%, var(--test-detail-border));
            box-shadow: 0 8px 16px rgba(9, 93, 93, 0.12);
        }

        .test-muted {
            margin: 0;
            color: var(--test-detail-muted);
            font-style: italic;
        }

        .test-comment {
            margin: 0;
            white-space: pre-line;
        }

        .danger-zone {
            border: 1px solid #f2c3c3;
            background: linear-gradient(180deg, #fff7f7, #fff0f0);
        }

        .danger-zone-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.8rem;
            flex-wrap: wrap;
        }

        .danger-zone-title {
            margin: 0;
            font-size: 1rem;
            color: #8d1f1f;
            font-weight: 700;
        }

        .btn-danger-zone {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            border: none;
            border-radius: 10px;
            padding: 0.55rem 0.9rem;
            color: #fff;
            text-decoration: none;
            background: linear-gradient(135deg, #d73a49, #9e1f2d);
            box-shadow: 0 10px 20px rgba(153, 28, 39, 0.2);
        }

        .btn-danger-zone:hover,
        .btn-danger-zone:focus,
        .btn-danger-zone:active,
        .btn-danger-zone:focus-visible {
            color: #fff !important;
            background: linear-gradient(135deg, #bf2f3c, #851926) !important;
        }

        .danger-zone .ea-delete-form {
            margin: 0;
        }

        .danger-zone .ea-delete-form .action-delete,
        .danger-zone .ea-delete-form button[type='submit'] {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            border: none !important;
            border-radius: 10px !important;
            padding: 0.55rem 0.9rem !important;
            color: #fff !important;
            text-decoration: none;
            background: linear-gradient(135deg, #d73a49, #9e1f2d) !important;
            box-shadow: 0 10px 20px rgba(153, 28, 39, 0.2);
        }

        .danger-zone .ea-delete-form .action-delete:hover,
        .danger-zone .ea-delete-form .action-delete:focus,
        .danger-zone .ea-delete-form .action-delete:active,
        .danger-zone .ea-delete-form button[type='submit']:hover,
        .danger-zone .ea-delete-form button[type='submit']:focus,
        .danger-zone .ea-delete-form button[type='submit']:active {
            color: #fff !important;
            background: linear-gradient(135deg, #bf2f3c, #851926) !important;
        }

        @media (max-width: 780px) {
            .test-detail-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
{% endblock %}

{% block content_title %}Fiche test{% endblock %}

{% block main %}
    <div class="test-detail-page">
        <div class="test-detail-toolbar">
            <a href="{{ ea_url().setAction('index') }}" class="btn btn-test-back">
                <i class="fa fa-arrow-left"></i> Retour à la liste
            </a>
            <a href="{{ ea_url().setAction('edit').setEntityId(entity.primaryKeyValue) }}" class="btn btn-test-edit">
                <i class="fa fa-pen"></i> Modifier
            </a>
        </div>

        <section class="test-detail-hero">
            <h2 class="test-detail-title">
                {{ entity.instance.subject ? entity.instance.subject.name : 'Matière inconnue' }}
                -
                {{ entity.instance.testDate ? entity.instance.testDate|date('d/m/Y') : 'Date inconnue' }}
            </h2>
            <p class="test-detail-subtitle">Vue détaillée du test et des notes associées.</p>
        </section>

        <div class="test-detail-grid">
            <section class="test-detail-card">
                <h3>Matière</h3>
                {% if entity.instance.subject is not null %}
                    <a href="{{ ea_url().setController('App\\Controller\\Admin\\SubjectCrudController').setAction('detail').setEntityId(entity.instance.subject.id) }}" class="test-chip test-user-link">
                        <i class="fa fa-book"></i> {{ entity.instance.subject.name|default(entity.instance.subject) }}
                    </a>
                {% else %}
                    <p class="test-muted">Aucune matière rattachée.</p>
                {% endif %}
            </section>

            <section class="test-detail-card">
                <h3>Section</h3>
                {% if entity.instance.section is not null %}
                    <a href="{{ ea_url().setController('App\\Controller\\Admin\\SectionsCrudController').setAction('detail').setEntityId(entity.instance.section.id) }}" class="test-chip test-user-link">
                        <i class="fa fa-layer-group"></i> {{ entity.instance.section.name|default(entity.instance.section) }}
                    </a>
                {% else %}
                    <p class="test-muted">Aucune section rattachée.</p>
                {% endif %}
            </section>

            <section class="test-detail-card">
                <h3>Enseignant</h3>
                {% if entity.instance.teacher is not null %}
                    {% set teacherController = 'App\\Controller\\Admin\\TeacherCrudController' %}
                    {% if 'ROLE_ADMIN' in entity.instance.teacher.roles|default([]) %}
                        {% set teacherController = 'App\\Controller\\Admin\\AdminCrudController' %}
                    {% endif %}

                    <a href="{{ ea_url().setController(teacherController).setAction('detail').setEntityId(entity.instance.teacher.id) }}" class="test-chip test-user-link">
                        <i class="fa fa-chalkboard-teacher"></i>
                        {{ entity.instance.teacher.lastName|default('') }} {{ entity.instance.teacher.firstName|default(entity.instance.teacher.username|default(entity.instance.teacher)) }}
                    </a>
                {% else %}
                    <p class="test-muted">Aucun enseignant rattaché.</p>
                {% endif %}
            </section>

            <section class="test-detail-card">
                <h3>Date du test</h3>
                <p>{{ entity.instance.testDate ? entity.instance.testDate|date('d/m/Y') : '-' }}</p>
            </section>
        </div>

        <section class="test-detail-card">
            <h3>Commentaire</h3>
            {% if entity.instance.comment is not empty %}
                <p class="test-comment">{{ entity.instance.comment }}</p>
            {% else %}
                <p class="test-muted">Aucun commentaire.</p>
            {% endif %}
        </section>

        <section class="test-detail-card">
            <h3>Notes attribuées</h3>
            {% if entity.instance.grades|length > 0 %}
                <div class="test-chip-wrap">
                    {% for grade in entity.instance.grades|sort((a, b) => b.updatedAt <=> a.updatedAt) %}
                        {% set studentLabel = (grade.student.lastName|default('') ~ ' ' ~ grade.student.firstName|default(grade.student.username|default('Élève'))) | trim %}
                        <a href="{{ ea_url().setController('App\\Controller\\Admin\\GradesCrudController').setAction('detail').setEntityId(grade.id) }}" class="test-chip test-user-link">
                            <i class="fa fa-chart-line"></i>
                            {{ studentLabel != '' ? studentLabel : 'Élève' }}
                            : {{ grade.grade }}
                        </a>
                    {% endfor %}
                </div>
            {% else %}
                <p class="test-muted">Aucune note rattachée.</p>
            {% endif %}
        </section>

        <section class="test-detail-card danger-zone">
            <div class="danger-zone-header">
                <h3 class="danger-zone-title">Zone de danger</h3>
                {% set deleteUrl = ea_url().setAction('delete').setEntityId(entity.primaryKeyValue) %}
                <button
                    type="button"
                    class="btn-danger-zone"
                    data-action-name="delete"
                    formaction="{{ deleteUrl }}"
                    data-bs-toggle="modal"
                    data-bs-target="#modal-delete"
                >
                    <i class="fa fa-trash"></i>
                    <span>Supprimer le test</span>
                </button>
                {{ include('@EasyAdmin/crud/includes/_delete_form.html.twig', { entity_id: entity.primaryKeyValue }, with_context: false) }}
            </div>
        </section>
    </div>
{% endblock %}
