{% extends '@EasyAdmin/crud/new.html.twig' %}

{% block configured_head_contents %}
    {{ parent() }}
    <style>
        :root {
            --grade-new-bg-start: #f7f4ee;
            --grade-new-bg-end: #ecf6f4;
            --grade-new-primary: #0e8a7d;
            --grade-new-secondary: #0a5e60;
            --grade-new-accent: #ec6f2f;
            --grade-new-text: #15323a;
            --grade-new-muted: #5f7680;
            --grade-new-surface: #ffffff;
            --grade-new-border: #d9ebe7;
            --grade-new-shadow: rgba(12, 64, 67, 0.14);
        }

        .grade-create-page {
            position: relative;
            max-width: 1040px;
            margin: 0 auto;
            display: grid;
            gap: 1rem;
            padding-bottom: 0.75rem;
        }

        .grade-create-page::before,
        .grade-create-page::after {
            content: '';
            position: absolute;
            z-index: 0;
            border-radius: 999px;
            pointer-events: none;
        }

        .grade-create-page::before {
            width: 240px;
            height: 240px;
            top: -40px;
            right: -30px;
            background: radial-gradient(circle at 30% 30%, rgba(236, 111, 47, 0.34), rgba(236, 111, 47, 0));
        }

        .grade-create-page::after {
            width: 300px;
            height: 300px;
            bottom: -70px;
            left: -60px;
            background: radial-gradient(circle at 50% 50%, rgba(14, 138, 125, 0.26), rgba(14, 138, 125, 0));
        }

        .grade-create-toolbar,
        .grade-create-hero,
        .grade-create-form-card {
            position: relative;
            z-index: 1;
        }

        .grade-create-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.7rem;
            flex-wrap: wrap;
        }

        .grade-create-back {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            color: var(--grade-new-text);
            background: color-mix(in srgb, var(--grade-new-bg-end) 60%, #ffffff);
            border: 1px solid var(--grade-new-border);
            border-radius: 12px;
            padding: 0.55rem 0.9rem;
            text-decoration: none;
            font-weight: 600;
        }

        .grade-create-back:hover,
        .grade-create-back:focus,
        .grade-create-back:active,
        .grade-create-back:focus-visible {
            color: var(--grade-new-text) !important;
            background: #ffffff !important;
            border-color: color-mix(in srgb, var(--grade-new-primary) 32%, var(--grade-new-border)) !important;
        }

        .grade-create-pill {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            padding: 0.35rem 0.7rem;
            border-radius: 999px;
            background: color-mix(in srgb, var(--grade-new-accent) 20%, #ffffff);
            color: color-mix(in srgb, var(--grade-new-accent) 72%, #8a3f19);
            font-size: 0.79rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
        }

        .grade-create-hero {
            overflow: hidden;
            border-radius: 18px;
            border: 1px solid color-mix(in srgb, var(--grade-new-primary) 25%, var(--grade-new-border));
            background:
                linear-gradient(130deg, rgba(255, 255, 255, 0.88), rgba(255, 255, 255, 0.44)),
                linear-gradient(130deg, var(--grade-new-bg-start), var(--grade-new-bg-end));
            box-shadow: 0 20px 40px var(--grade-new-shadow);
            padding: 1.3rem;
        }

        .grade-create-title {
            margin: 0;
            font-size: clamp(1.3rem, 2.2vw, 1.8rem);
            line-height: 1.12;
            color: var(--grade-new-text);
            letter-spacing: -0.02em;
        }

        .grade-create-subtitle {
            margin: 0.55rem 0 0;
            color: var(--grade-new-muted);
            font-size: 0.95rem;
            max-width: 54ch;
        }

        .grade-create-form-card {
            border-radius: 18px;
            padding: 1.1rem;
            border: 1px solid color-mix(in srgb, var(--grade-new-primary) 18%, var(--grade-new-border));
            background: var(--grade-new-surface);
            box-shadow: 0 16px 32px rgba(14, 76, 84, 0.1);
        }

        .grade-create-section {
            border-radius: 14px;
            border: 1px solid color-mix(in srgb, var(--grade-new-primary) 16%, var(--grade-new-border));
            background: linear-gradient(180deg, #ffffff, color-mix(in srgb, var(--grade-new-bg-end) 22%, #ffffff));
            padding: 0.95rem;
        }

        .grade-create-section + .grade-create-section {
            margin-top: 0.85rem;
        }

        .grade-create-section-title {
            margin: 0 0 0.72rem;
            color: var(--grade-new-text);
            font-size: 0.94rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 0.45rem;
            letter-spacing: 0.02em;
            text-transform: uppercase;
        }

        .grade-create-section-title::before {
            content: '';
            width: 11px;
            height: 11px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--grade-new-primary), var(--grade-new-accent));
            box-shadow: 0 0 0 4px color-mix(in srgb, var(--grade-new-primary) 22%, transparent);
        }

        .grade-create-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 0.8rem;
        }

        .grade-create-form-card .form-label,
        .grade-create-form-card label {
            color: color-mix(in srgb, var(--grade-new-text) 88%, #102026);
            font-weight: 700;
            margin-bottom: 0.35rem;
        }

        .grade-create-form-card .form-control,
        .grade-create-form-card .form-select {
            border-radius: 10px;
            border: 1px solid color-mix(in srgb, var(--grade-new-primary) 18%, var(--grade-new-border));
            min-height: 42px;
            background: #ffffff;
        }

        .grade-create-form-card .form-control:focus,
        .grade-create-form-card .form-select:focus {
            border-color: color-mix(in srgb, var(--grade-new-primary) 70%, #0a5e60);
            box-shadow: 0 0 0 0.2rem color-mix(in srgb, var(--grade-new-primary) 22%, transparent);
        }

        .grade-create-form-card textarea.form-control {
            min-height: 110px;
        }

        .grade-create-form-card .ea-form-actions,
        .grade-create-form-card .form-actions {
            border-top: 1px dashed color-mix(in srgb, var(--grade-new-primary) 26%, var(--grade-new-border));
            margin-top: 0.9rem;
            padding-top: 0.9rem;
        }

        .btn-primary {
            border: none !important;
            color: #fff !important;
            border-radius: 11px !important;
            font-weight: 700;
            background: linear-gradient(135deg, var(--grade-new-primary), var(--grade-new-secondary)) !important;
            box-shadow: 0 10px 18px rgba(9, 94, 96, 0.24);
            padding: 0.55rem 1rem !important;
        }

        .btn-primary:hover,
        .btn-primary:focus,
        .btn-primary:active,
        .btn-primary:focus-visible {
            color: #fff !important;
            transform: translateY(-1px);
            box-shadow: 0 12px 20px rgba(9, 94, 96, 0.28);
        }

        @media (max-width: 780px) {
            .grade-create-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
{% endblock %}

{% block main %}
    <div class="grade-create-page">
        <div class="grade-create-toolbar">
            <a href="{{ ea_url().setAction('index') }}" class="grade-create-back">
                <i class="fa fa-arrow-left"></i> Retour
            </a>
            <span class="grade-create-pill"><i class="fa fa-chart-line"></i> Nouvelle note</span>
        </div>

        <section class="grade-create-hero">
            <h2 class="grade-create-title">Créer une note</h2>
            <p class="grade-create-subtitle">Associez l'élève, le test et le type de note puis renseignez la valeur.</p>
        </section>

        <section class="grade-create-form-card">
            {{ form_start(new_form) }}

            <div class="grade-create-section">
                <h3 class="grade-create-section-title">Informations de la note</h3>
                <div class="grade-create-grid">
                    {% if new_form.student is defined %}
                        {{ form_row(new_form.student) }}
                    {% endif %}
                    {% if new_form.test is defined %}
                        {{ form_row(new_form.test) }}
                    {% endif %}
                </div>
                <div class="grade-create-grid">
                    {% if new_form.gradeType is defined %}
                        {{ form_row(new_form.gradeType) }}
                    {% endif %}
                    {% if new_form.grade is defined %}
                        {{ form_row(new_form.grade) }}
                    {% endif %}
                </div>
            </div>

            <div class="grade-create-section">
                <h3 class="grade-create-section-title">Commentaire</h3>
                {% if new_form.comment is defined %}
                    {{ form_row(new_form.comment) }}
                {% endif %}
            </div>

            {{ form_rest(new_form) }}
            {{ form_end(new_form, { render_rest: false }) }}
        </section>
    </div>
{% endblock %}
