{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}Dashboard{% endblock %}

{% block main %}
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <h1>Bienvenue sur votre page administrateur Scorea</h1>
                <p>Utilisez le menu de navigation pour accéder aux différentes sections.</p>
            </div>
        </div>
        
        <div class="row mt-4">
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title"><i class="fa fa-user"></i> Utilisateurs</h5>
                        <p class="card-text">Gérer les utilisateurs de la plateforme.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title"><i class="fa fa-chalkboard"></i> Classes</h5>
                        <p class="card-text">Gérer les classes et leurs attributions.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title"><i class="fa fa-school"></i> Formations</h5>
                        <p class="card-text">Gérer les formations disponibles.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
