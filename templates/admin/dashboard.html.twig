{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}Dashboard{% endblock %}

{% block main %}
<div class="dashboard-container theme-admin">
    {% set firstName = currentUser and currentUser.firstName ? currentUser.firstName : '' %}
    {% set lastName = currentUser and currentUser.lastName ? currentUser.lastName : '' %}
    {% set username = currentUser and currentUser.username ? currentUser.username : 'admin' %}
    {% set initials = (firstName|slice(0, 1) ~ lastName|slice(0, 1))|upper %}
    {% if initials is empty %}
        {% set initials = username|slice(0, 2)|upper %}
    {% endif %}

    <section class="dashboard-hero">
        <div class="hero-content">
            <p class="hero-kicker">Espace administration</p>
            <div class="hero-user-row">
                <div class="hero-avatar" aria-hidden="true">{{ initials }}</div>
                <div class="hero-user-meta">
                    <h1 class="welcome-title">
                        Bienvenue
                        <span class="user-name">
                            {% if firstName is not empty or lastName is not empty %}
                                {{ firstName }} {{ lastName }}
                            {% else %}
                                ADMIN
                            {% endif %}
                        </span>
                    </h1>
                </div>
            </div>
            <p class="welcome-subtitle">Tableau de bord <span class="name-highlight">Scorea</span> pour piloter les classes et les étudiants.</p>
        </div>
        <div class="hero-date-card">
            <span class="date-value">{{ formattedDate | capitalize }}</span>
        </div>
    </section>

    <section class="statistics-section">
        <div class="section-head">
            <h2 class="section-title">Statistiques globales</h2>
        </div>

        <div class="stats-grid">
            <a href="{{ ea_url({ crudAction: 'index', crudControllerFqcn: 'App\\Controller\\Admin\\StudentCrudController' }) }}" class="stat-card stat-card-link stat-students">
                <div class="stat-icon">
                    <i class="fas fa-users"></i>
                </div>
                <div class="stat-content">
                    <h3>Étudiants</h3>
                    <p class="stat-number">{{ studentCount }}</p>
                </div>
            </a>

            <a href="{{ ea_url({ crudAction: 'index', crudControllerFqcn: 'App\\Controller\\Admin\\TeacherCrudController' }) }}" class="stat-card stat-card-link stat-teachers">
                <div class="stat-icon">
                    <i class="fas fa-chalkboard-user"></i>
                </div>
                <div class="stat-content">
                    <h3>Professeurs</h3>
                    <p class="stat-number">{{ teacherCount }}</p>
                </div>
            </a>

            <a href="{{ ea_url({ crudAction: 'index', crudControllerFqcn: 'App\\Controller\\Admin\\SectionsCrudController' }) }}" class="stat-card stat-card-link stat-classes">
                <div class="stat-icon">
                    <i class="fas fa-school"></i>
                </div>
                <div class="stat-content">
                    <h3>Sections</h3>
                    <p class="stat-number">{{ classCount }}</p>
                </div>
            </a>

            <a href="{{ ea_url({ crudAction: 'index', crudControllerFqcn: 'App\\Controller\\Admin\\TrainingCrudController' }) }}" class="stat-card stat-card-link stat-trainings">
                <div class="stat-icon">
                    <i class="fas fa-graduation-cap"></i>
                </div>
                <div class="stat-content">
                    <h3>Formations</h3>
                    <p class="stat-number">{{ trainingCount }}</p>
                </div>
            </a>
        </div>
    </section>

    <section class="alerts">
        <div class="section-head">
            <h2 class="section-title">Alertes récentes</h2>
            <span class="section-note">{{ recentAlerts|length }} élément(s)</span>
        </div>

        {% if recentAlerts is not empty %}
            <ul class="alerts-list">
                {% for alert in recentAlerts %}
                    {% set typeClass = alert.type == 'warning' ? 'is-warning' : (alert.type == 'error' ? 'is-error' : 'is-info') %}
                    <li class="alert-item {{ typeClass }}">
                        <div class="alert-icon">
                            {% if alert.type == 'warning' %}
                                <i class="fas fa-exclamation-triangle"></i>
                            {% elseif alert.type == 'error' %}
                                <i class="fas fa-times-circle"></i>
                            {% else %}
                                <i class="fas fa-info-circle"></i>
                            {% endif %}
                        </div>
                        <div class="alert-content">
                            <p class="alert-message">{{ alert.message }}</p>
                            <p class="alert-date">{{ alert.createdAt|date('d M Y H:i') }}</p>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="no-alerts">Aucune alerte récente.</p>
        {% endif %}
    </section>
</div>

<style>
    body:not(.ea-content-width-full) .content-wrapper {
        max-inline-size: 100%;
    }

    .content-wrapper {
        padding-inline: 12px;
    }

    @media (min-width: 992px) {
        .content-wrapper {
            padding-inline: 18px;
        }
    }

    .dashboard-container {
        --bg-0: #f6f8ff;
        --bg-1: #ecf1ff;
        --panel: #ffffff;
        --text: #222a3b;
        --muted: #677287;
        --border: #e1e8f9;
        --primary: #2f6dff;
        --secondary: #1f43a5;
        --hero-glow: rgba(47, 109, 255, 0.18);
        min-height: auto;
        width: 100%;
        padding: 24px;
        display: flex;
        flex-direction: column;
        gap: 40px;
        background: radial-gradient(circle at 5% 0%, #ffffff 0%, var(--bg-0) 35%, var(--bg-1) 100%);
        border-radius: 18px;
    }

    .dashboard-container.theme-admin {
        --bg-0: #fff6f5;
        --bg-1: #feeceb;
        --text: #332120;
        --muted: #7f6661;
        --border: #f0d5d2;
        --primary: #cf3f33;
        --secondary: #8b2018;
        --hero-glow: rgba(207, 63, 51, 0.2);
    }

    .dashboard-hero {
        position: relative;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 18px;
        padding: 22px;
        border-radius: 20px;
        background: linear-gradient(125deg, var(--primary), var(--secondary));
        color: #ffffff;
        overflow: hidden;
        box-shadow: 0 16px 38px var(--hero-glow);
    }

    .statistics-section {
        margin-bottom: 4px;
    }

    .dashboard-hero::before,
    .dashboard-hero::after {
        content: '';
        position: absolute;
        border-radius: 999px;
        pointer-events: none;
        opacity: 0.35;
        background: rgba(255, 255, 255, 0.32);
    }

    .dashboard-hero::before {
        width: 260px;
        height: 260px;
        top: -120px;
        right: -90px;
    }

    .dashboard-hero::after {
        width: 140px;
        height: 140px;
        bottom: -60px;
        left: 45%;
    }

    .hero-content {
        position: relative;
        z-index: 1;
    }

    .hero-user-row {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .hero-avatar {
        width: 62px;
        height: 62px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        background: linear-gradient(145deg, rgba(255, 255, 255, 0.98), rgba(255, 255, 255, 0.78));
        color: color-mix(in srgb, var(--secondary) 70%, #000000);
        border: 2px solid rgba(255, 255, 255, 0.55);
        box-shadow: 0 10px 22px rgba(0, 0, 0, 0.18);
        font-weight: 800;
        font-size: 22px;
        letter-spacing: 0.04em;
    }

    .hero-user-meta {
        min-width: 0;
    }

    .hero-kicker {
        margin: 0 0 8px;
        font-size: 12px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        opacity: 0.88;
        font-weight: 700;
    }

    .welcome-title {
        margin: 0;
        font-size: 30px;
        line-height: 1.15;
        font-weight: 800;
    }

    .welcome-title .user-name,
    .welcome-subtitle .name-highlight {
        color: #ffffff;
        font-weight: 800;
    }

    .welcome-subtitle {
        margin: 10px 0 0;
        font-size: 15px;
        max-width: 680px;
        opacity: 0.93;
    }

    .hero-username {
        font-size: 13px;
        font-weight: 600;
        opacity: 0.9;
    }

    .hero-date-card {
        position: relative;
        z-index: 1;
        min-width: 210px;
        display: grid;
        gap: 6px;
        padding: 14px 16px;
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.18);
        border: 1px solid rgba(255, 255, 255, 0.35);
        backdrop-filter: blur(3px);
    }

    .date-label {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        opacity: 0.86;
        font-weight: 700;
    }

    .date-value {
        text-align: center;
        font-size: 14px;
        font-weight: 700;
        line-height: 1.4;
    }

    .section-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 16px;
    }

    .section-title {
        margin: 0;
        font-size: 20px;
        line-height: 1.2;
        color: var(--text);
        font-weight: 750;
    }

    .section-note {
        font-size: 13px;
        color: var(--muted);
        font-weight: 600;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 16px;
    }

    .stat-card {
        position: relative;
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: 14px;
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 16px;
        box-shadow: 0 6px 16px rgba(22, 34, 68, 0.07);
        transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
    }

    .stat-card-link {
        text-decoration: none;
        color: inherit;
    }

    .stat-card:hover,
    .stat-card:focus-visible {
        transform: translateY(-4px);
        box-shadow: 0 14px 26px rgba(22, 34, 68, 0.12);
        border-color: color-mix(in srgb, var(--primary) 30%, var(--border));
    }

    .stat-icon {
        width: 54px;
        height: 54px;
        border-radius: 12px;
        display: grid;
        place-items: center;
        font-size: 22px;
        color: var(--primary);
        background: color-mix(in srgb, var(--primary) 12%, white);
        flex-shrink: 0;
    }

    .stat-content h3 {
        margin: 0 0 4px;
        font-size: 12px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted);
        font-weight: 700;
    }

    .stat-number {
        margin: 0;
        color: var(--text);
        font-size: 30px;
        line-height: 1;
        font-weight: 800;
    }

    .stat-students {
        --primary: #1f6feb;
    }

    .stat-teachers {
        --primary: #a455e6;
    }

    .stat-classes {
        --primary: #1f9d6a;
    }

    .stat-trainings {
        --primary: #cd7a13;
    }

    .alerts {
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 16px;
    }

    .alerts-list {
        margin: 0;
        padding: 0;
        list-style: none;
        display: grid;
        gap: 10px;
    }

    .alert-item {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 12px;
        align-items: flex-start;
        border-radius: 12px;
        border: 1px solid #d8e5ff;
        background: #f4f8ff;
        padding: 12px;
        animation: fadeSlideIn 0.28s ease-out;
    }

    .alert-item.is-warning {
        border-color: #f4e0b8;
        background: #fff9ef;
    }

    .alert-item.is-error {
        border-color: #efcccc;
        background: #fff4f4;
    }

    .alert-icon {
        width: 30px;
        height: 30px;
        display: grid;
        place-items: center;
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.9);
        font-size: 16px;
        color: #2480df;
    }

    .alert-item.is-warning .alert-icon {
        color: #c98313;
    }

    .alert-item.is-error .alert-icon {
        color: #d6473a;
    }

    .alert-message {
        margin: 0 0 4px;
        font-size: 14px;
        font-weight: 600;
        color: var(--text);
    }

    .alert-date {
        margin: 0;
        font-size: 12px;
        color: var(--muted);
    }

    .no-alerts {
        margin: 0;
        border: 1px dashed var(--border);
        border-radius: 12px;
        padding: 18px;
        text-align: center;
        color: var(--muted);
        font-style: italic;
        background: #ffffff;
    }

    @keyframes fadeSlideIn {
        from {
            opacity: 0;
            transform: translateY(6px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @media (max-width: 900px) {
        .dashboard-hero {
            flex-direction: column;
            align-items: stretch;
            margin-bottom: 20px;
        }

        .hero-date-card {
            min-width: 0;
        }

        .section-head {
            flex-direction: column;
            align-items: flex-start;
        }
    }

    @media (max-width: 620px) {
        .dashboard-container {
            padding: 12px;
            min-height: auto;
        }

        .dashboard-hero {
            padding: 18px;
        }

        .welcome-title {
            font-size: 24px;
        }

        .hero-avatar {
            width: 50px;
            height: 50px;
            font-size: 18px;
        }

        .hero-user-row {
            gap: 10px;
        }

        .welcome-subtitle {
            font-size: 14px;
        }

        .stat-card {
            grid-template-columns: auto 1fr;
        }

        .stat-chip {
            grid-column: 1 / -1;
            justify-self: flex-start;
        }
    }
</style>
{% endblock %}
